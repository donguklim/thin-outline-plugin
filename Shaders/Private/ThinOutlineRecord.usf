/*=============================================================================
	ThinOutlineRecord.usf: updates the per-pixel edge records with this frame's jittered sample.

	The previous frame's records are fetched at the reprojected position and moved into this pixel's local coordinates,
	unless the history is rejected. Then this frame's edge checks add their samples.

	History reprojection (r.ThinOutline.Estimator.HistoryReprojection):
	- Nearest: the history pixel nearest to the reprojected position. A record only moves by whole pixels while its edge
	  moves by fractions, so under motion records slip past the edge (behind it when the fraction of the motion is below
	  half a pixel, ahead of it above), leave the pixels that can sample the edge, and linger there while they decay.
	- Bilinear: the four history pixels around the reprojected position, each moved into this pixel's coordinates and
	  merged with bilinear weights (their sample counts scaled by the weights), so records follow the edge continuously.
	- Range drop: a reprojected record whose edge has left the pixel's sampling range is dropped (see
	  DropRecordOutsideSamplingRange).

	Each axis keeps one record, either a crease or a silhouette record, and the two types are reprojected differently:
	Crease records belong to the pixel's own surface: they move with its velocity and are kept while their depth
	matches the pixel's.
	Silhouette records belong to the contour of the foreground next to the pixel, which the outline wraps around:
	they move with the foreground's velocity and are kept while their foreground depth matches, and while the
	direction the foreground is seen from has not turned too far (the contour slides over the surface when it does).
	Sky pixels have silhouette records only.
	Both reprojections run, each taking the history taps whose record on the axis has its type. Then the axis keeps the
	record of one type (see UpdateAxisRecord).
=============================================================================*/

#include "ThinOutlineCommon.ush"

Texture2D<float4> HistoryHorizontalA;
Texture2D<float4> HistoryHorizontalB;
Texture2D<float4> HistoryVerticalA;
Texture2D<float4> HistoryVerticalB;
// Kept ratio of the (horizontal, vertical) records, if they are silhouette records.
Texture2D<float2> HistorySilhouetteKept;
// (linear depth of the pixel's surface, linear depth of its foreground).
Texture2D<float2> HistoryDepth;

RWTexture2D<float4> RWHorizontalA;
RWTexture2D<float4> RWHorizontalB;
RWTexture2D<float4> RWVerticalA;
RWTexture2D<float4> RWVerticalB;
RWTexture2D<float2> RWSilhouetteKept;
RWTexture2D<float2> RWDepth;

// This frame's G-buffer sample position inside its rendering pixel, in pixel-local coordinates [0, 1]^2.
float2 SampleLocalPosition;
// 1 - decay rate, applied to the sample counts once per frame.
float SampleCountDecay;
// Relative depth tolerances of the history depth tests.
float CreaseHistoryDepthThreshold;
float SilhouetteHistoryDepthThreshold;
// Cosine of the largest angle the view direction of a silhouette may turn by in one frame.
float SilhouetteHistoryCosAngle;
// A crease sample only takes over a silhouette record with fewer samples than this.
float SilhouetteCreaseTakeoverSampleCount;
uint bHistoryValid;
// Bit 0: drop records outside the sampling range. Bit 1: bilinear history instead of the nearest history pixel.
uint HistoryReprojectionMode;

#define HISTORY_RANGE_DROP 1
#define HISTORY_BILINEAR 2

float2 ViewportPosToScreenPos(int2 ViewportPos)
{
	return (float2(ViewportPos) + 0.5) * View.ViewSizeAndInvSize.zw * float2(2.0, -2.0) + float2(-1.0, 1.0);
}

// Screen velocity (and device Z velocity) of a pixel that did not draw velocity: camera motion only.
float3 ComputeStaticVelocity(float2 ScreenPos, float DeviceZ)
{
	const float3 PosN = float3(ScreenPos, DeviceZ);
	const float4 PrevClip = mul(float4(PosN, 1.0), View.ClipToPrevClip);
	return PosN - PrevClip.xyz / PrevClip.w;
}

float3 GetPixelVelocity(int2 PixelPos, float DeviceZ)
{
	const float4 EncodedVelocity = SceneTexturesStruct.GBufferVelocityTexture.Load(int3(PixelPos, 0));
	return EncodedVelocity.x > 0.0
		? DecodeVelocityFromTexture(EncodedVelocity)
		: ComputeStaticVelocity(ViewportPosToScreenPos(PixelPos - int2(View.ViewRectMin.xy)), DeviceZ);
}

// History pixels of a point at ScreenPos that moved by ScreenVelocity (see the top of the file), with their weights and
// this pixel's center relative to each one's center. Taps outside the view get no weight.
struct FThinOutlineHistoryTaps
{
	int2 Pixels[4];
	float2 Offsets[4];
	float Weights[4];
};

FThinOutlineHistoryTaps GetHistoryTaps(float2 ScreenPos, float2 ScreenVelocity)
{
	const float2 ViewSize = View.ViewSizeAndInvSize.xy;
	const float2 PrevViewportPos = ((ScreenPos - ScreenVelocity) * float2(0.5, -0.5) + 0.5) * ViewSize;

	FThinOutlineHistoryTaps Taps;
	const bool bBilinear = (HistoryReprojectionMode & HISTORY_BILINEAR) != 0;
	const float2 Corner = PrevViewportPos - 0.5;
	const int2 BasePixel = bBilinear ? int2(floor(Corner)) : int2(floor(PrevViewportPos));
	const float2 Fraction = Corner - float2(BasePixel);

	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const int2 Step = int2(Index & 1, Index >> 1);
		Taps.Pixels[Index] = BasePixel + Step;
		Taps.Offsets[Index] = PrevViewportPos - (float2(Taps.Pixels[Index]) + 0.5);

		const float2 AxisWeights = lerp(1.0 - Fraction, Fraction, float2(Step));
		Taps.Weights[Index] = bBilinear ? AxisWeights.x * AxisWeights.y : (Index == 0 ? 1.0 : 0.0);
		if (any(Taps.Pixels[Index] < 0) || any(Taps.Pixels[Index] >= int2(ViewSize)))
		{
			Taps.Weights[Index] = 0.0;
		}
	}
	return Taps;
}

// Merges one history record, moved into this pixel's coordinates, into the reprojected record with a weight: its
// samples keep their relative weights, scaled by Weight.
void AddHistoryRecord(inout FThinOutlineRecord Reprojected, FThinOutlineRecord Record, float2 Offset, float Weight)
{
	ShiftRecord(Record, Offset);
	Record.SampleCount *= Weight;
	Reprojected = MergeRecords(Reprojected, Record);
}

// Merges the records of one history tap that are of the given edge type into the reprojected records of the two axes.
void AddHistoryTap(
	inout FThinOutlineRecord HorizontalRecord,
	inout FThinOutlineRecord VerticalRecord,
	uint EdgeType,
	int3 Texel,
	float2 Offset,
	float Weight)
{
	uint HorizontalType;
	uint VerticalType;
	FThinOutlineRecord TapHorizontal = UnpackRecord(HistoryHorizontalA.Load(Texel), HistoryHorizontalB.Load(Texel), HorizontalType);
	FThinOutlineRecord TapVertical = UnpackRecord(HistoryVerticalA.Load(Texel), HistoryVerticalB.Load(Texel), VerticalType);
	if (EdgeType == EDGE_SILHOUETTE)
	{
		const float2 KeptRatio = HistorySilhouetteKept.Load(Texel);
		TapHorizontal.KeptRatio = KeptRatio.x;
		TapVertical.KeptRatio = KeptRatio.y;
	}

	if (HorizontalType == EdgeType)
	{
		AddHistoryRecord(HorizontalRecord, TapHorizontal, Offset.xy, Weight);
	}
	if (VerticalType == EdgeType)
	{
		AddHistoryRecord(VerticalRecord, TapVertical, Offset.yx, Weight);
	}
}

// A pixel samples an edge only while the edge lies in the pixel or in one of its two neighbours along the axis, so its
// samples' u (trapezoid midlines 0.5 + E / 2 for an edge at u = E in (-1, 2)) lie in [0, 1.5]. A reprojected record whose
// midline leaves that range over the pixel's whole span across the axis (v in [0, 1]) describes an edge the pixel can no
// longer sample: dropped instead of lingering. The midline follows the record's own slope, since a slanted edge that
// moves across the axis keeps its mean u while its samples leave the pixel.
void DropRecordOutsideSamplingRange(inout FThinOutlineRecord Record)
{
	if ((HistoryReprojectionMode & HISTORY_RANGE_DROP) == 0 || Record.SampleCount <= 0.0)
	{
		return;
	}

	const float Slope = Record.Variance.y > THIN_OUTLINE_MIN_FIT_VARIANCE ? Record.Covariance / Record.Variance.y : 0.0;
	const float MidlineAtV0 = Record.Mean.x - Slope * Record.Mean.y;
	const float MidlineAtV1 = MidlineAtV0 + Slope;
	if (max(MidlineAtV0, MidlineAtV1) < 0.0 || min(MidlineAtV0, MidlineAtV1) > 1.5)
	{
		Record = GetEmptyRecord();
	}
}

// Fetches the previous frame's crease records of the surface under this pixel, moved into this pixel's local
// coordinates. Returns false when there is no usable history.
bool ReprojectCreaseRecords(
	int2 ViewportPos,
	int2 PixelPos,
	FThinOutlineSample Center,
	out FThinOutlineRecord HorizontalRecord,
	out FThinOutlineRecord VerticalRecord)
{
	HorizontalRecord = GetEmptyRecord();
	VerticalRecord = GetEmptyRecord();

	const float3 Velocity = GetPixelVelocity(PixelPos, Center.DeviceZ);
	const FThinOutlineHistoryTaps Taps = GetHistoryTaps(ViewportPosToScreenPos(ViewportPos), Velocity.xy);

	// Expected depth of this surface in the previous frame. A crease lies on a depth-continuous surface, so a history
	// pixel of the same surface only differs by the depth change across the jitter, up to about a pixel's step, which
	// the threshold has to cover on surfaces seen at a grazing angle.
	const float PrevDepth = ConvertFromDeviceZ(Center.DeviceZ - Velocity.z);
	const float Tolerance = CreaseHistoryDepthThreshold * PrevDepth;

	bool bAnyTap = false;
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const int3 Texel = int3(Taps.Pixels[Index], 0);

		BRANCH
		if (Taps.Weights[Index] > 0.0)
		{
			const float StoredDepth = HistoryDepth.Load(Texel).x;
			if (abs(StoredDepth - PrevDepth) <= Tolerance)
			{
				bAnyTap = true;
				AddHistoryTap(HorizontalRecord, VerticalRecord, EDGE_CREASE, Texel, Taps.Offsets[Index], Taps.Weights[Index]);
			}
		}
	}
	return bAnyTap;
}

// The foreground a silhouette record next to this pixel belongs to: the nearest pixel within two pixels along the
// axes, the pixel itself included. A record belongs to a pixel at most one pixel from the contour, and a pixel
// one pixel outside it may see only background in its axial neighbours this frame.
struct FThinOutlineForeground
{
	int2 PixelPos;
	float DeviceZ;
	float Depth;
	bool bIsSky;
	// Depth range of the foreground's surface around it (its axial neighbours on the same surface included): the
	// jitter moves the samples by up to a pixel, which on a surface seen at a grazing angle is a large depth change.
	float MinDepth;
	float MaxDepth;
};

FThinOutlineForeground FindForeground(int2 PixelPos, FThinOutlineSample Center, FThinOutlineSample Neighbours[4], FThinOutlineSample FarNeighbours[4])
{
	FThinOutlineForeground Foreground;
	Foreground.PixelPos = PixelPos;
	Foreground.DeviceZ = Center.DeviceZ;

	// Reversed Z: nearer is larger.
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		if (Neighbours[Index].DeviceZ > Foreground.DeviceZ)
		{
			Foreground.PixelPos = ClampToViewRect(PixelPos + NeighbourOffsets[Index]);
			Foreground.DeviceZ = Neighbours[Index].DeviceZ;
		}
		if (FarNeighbours[Index].DeviceZ > Foreground.DeviceZ)
		{
			Foreground.PixelPos = ClampToViewRect(PixelPos + 2 * NeighbourOffsets[Index]);
			Foreground.DeviceZ = FarNeighbours[Index].DeviceZ;
		}
	}

	Foreground.bIsSky = IsSkyDeviceZ(Foreground.DeviceZ);
	Foreground.Depth = DeviceZToDepth(Foreground.DeviceZ);
	Foreground.MinDepth = Foreground.Depth;
	Foreground.MaxDepth = Foreground.Depth;

	if (!Foreground.bIsSky)
	{
		const FThinOutlineSample ForegroundSample = LoadDepthSample(Foreground.PixelPos);
		FThinOutlineSample ForegroundNeighbours[4];
		FThinOutlineSample ForegroundFarNeighbours[4];
		UNROLL
		for (uint Index = 0; Index < 4; ++Index)
		{
			ForegroundNeighbours[Index] = LoadDepthSample(Foreground.PixelPos + NeighbourOffsets[Index]);
			ForegroundFarNeighbours[Index] = LoadDepthSample(Foreground.PixelPos + 2 * NeighbourOffsets[Index]);
		}

		UNROLL
		for (uint Index = 0; Index < 4; ++Index)
		{
			if (GetDepthEdgeMeasure(ForegroundSample, ForegroundNeighbours[Index], ForegroundNeighbours[Index ^ 1], ForegroundFarNeighbours[Index]) <= SilhouetteThreshold)
			{
				Foreground.MinDepth = min(Foreground.MinDepth, ForegroundNeighbours[Index].Depth);
				Foreground.MaxDepth = max(Foreground.MaxDepth, ForegroundNeighbours[Index].Depth);
			}
		}
	}
	return Foreground;
}

// Fetches the previous frame's silhouette records of the foreground contour next to this pixel, moved into this
// pixel's local coordinates. Returns false when there is no usable history.
bool ReprojectSilhouetteRecords(
	int2 ViewportPos,
	FThinOutlineForeground Foreground,
	out FThinOutlineRecord HorizontalRecord,
	out FThinOutlineRecord VerticalRecord)
{
	HorizontalRecord = GetEmptyRecord();
	VerticalRecord = GetEmptyRecord();

	// Without geometry around, there is no contour.
	if (Foreground.bIsSky)
	{
		return false;
	}

	const float3 Velocity = GetPixelVelocity(Foreground.PixelPos, Foreground.DeviceZ);
	const float2 ScreenPos = ViewportPosToScreenPos(ViewportPos);

	// Translated world view directions. Directions do not depend on the frame's translation, so they can be compared.
	const float3 ViewDirection = normalize(mul(float4(ScreenPos, 1.0, 0.0), View.ScreenToTranslatedWorld).xyz);
	const float3 PrevViewDirection = normalize(mul(float4(ScreenPos - Velocity.xy, 1.0, 0.0), View.PrevScreenToTranslatedWorld).xyz);
	if (dot(ViewDirection, PrevViewDirection) < SilhouetteHistoryCosAngle)
	{
		return false;
	}

	// The history stored the depth of its foreground. Expected depth range of this foreground in the previous frame:
	const float PrevDepth = ConvertFromDeviceZ(Foreground.DeviceZ - Velocity.z);
	const float DepthShift = PrevDepth - Foreground.Depth;
	const float Tolerance = SilhouetteHistoryDepthThreshold * PrevDepth;

	const FThinOutlineHistoryTaps Taps = GetHistoryTaps(ScreenPos, Velocity.xy);

	bool bAnyTap = false;
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const int3 Texel = int3(Taps.Pixels[Index], 0);

		BRANCH
		if (Taps.Weights[Index] > 0.0)
		{
			const float StoredDepth = HistoryDepth.Load(Texel).y;
			if (StoredDepth >= Foreground.MinDepth + DepthShift - Tolerance && StoredDepth <= Foreground.MaxDepth + DepthShift + Tolerance)
			{
				bAnyTap = true;
				AddHistoryTap(HorizontalRecord, VerticalRecord, EDGE_SILHOUETTE, Texel, Taps.Offsets[Index], Taps.Weights[Index]);
			}
		}
	}
	return bAnyTap;
}

// Adds this frame's samples of the two checks of one axis. The first (left or top) check's samples are kept as they
// are, the second (right or bottom) check's samples are moved by +0.5 along the axis.
void AddAxisSamples(inout FThinOutlineRecord Record, float2 Sample, float FirstStrength, float SecondStrength)
{
	const bool bFirst = FirstStrength > 0.0;
	const bool bSecond = SecondStrength > 0.0;
	const float CoTrigger = bFirst && bSecond ? 1.0 : 0.0;

	if (bFirst)
	{
		AddRecordSample(Record, Sample, 1.0, CoTrigger, FirstStrength);
	}
	if (bSecond)
	{
		AddRecordSample(Record, Sample + float2(0.5, 0.0), 0.0, CoTrigger, SecondStrength);
	}
}

void FinalizeRecord(inout FThinOutlineRecord Record)
{
	if (Record.SampleCount < THIN_OUTLINE_EMPTY_SAMPLE_COUNT)
	{
		Record = GetEmptyRecord();
	}
}

// Picks the record one axis keeps from its reprojected crease and silhouette records (already decayed), and adds this
// frame's samples of that type. A silhouette sample always takes the record over. A crease sample only takes over a
// silhouette record that has faded below SilhouetteCreaseTakeoverSampleCount, and is ignored otherwise: the edge pixel of
// a silhouette samples the background on some frames and the foreground, which may have creases, on others.
void UpdateAxisRecord(
	FThinOutlineRecord CreaseRecord,
	FThinOutlineRecord SilhouetteRecord,
	float2 Sample,
	float FirstCrease,
	float SecondCrease,
	float FirstSilhouette,
	float SecondSilhouette,
	out FThinOutlineRecord Record,
	out uint EdgeType)
{
	const bool bSilhouetteSample = max(FirstSilhouette, SecondSilhouette) > 0.0;
	const bool bCreaseSample = max(FirstCrease, SecondCrease) > 0.0;
	const bool bSilhouetteHolds = SilhouetteRecord.SampleCount > 0.0 && SilhouetteRecord.SampleCount >= SilhouetteCreaseTakeoverSampleCount;

	if (bSilhouetteSample || bSilhouetteHolds)
	{
		Record = SilhouetteRecord;
		EdgeType = EDGE_SILHOUETTE;
		AddAxisSamples(Record, Sample, FirstSilhouette, SecondSilhouette);
	}
	else if (bCreaseSample || CreaseRecord.SampleCount > 0.0)
	{
		Record = CreaseRecord;
		EdgeType = EDGE_CREASE;
		AddAxisSamples(Record, Sample, FirstCrease, SecondCrease);
	}
	else
	{
		// A faded silhouette record, if any, decays on.
		Record = SilhouetteRecord;
		EdgeType = EDGE_SILHOUETTE;
	}

	FinalizeRecord(Record);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 ViewportPos = int2(DispatchThreadId);
	if (any(ViewportPos >= int2(View.ViewSizeAndInvSize.xy)))
	{
		return;
	}

	const int2 PixelPos = int2(View.ViewRectMin.xy) + ViewportPos;

	FThinOutlineSample Center;
	FThinOutlineSample Neighbours[4];
	FThinOutlineSample FarNeighbours[4];
	LoadOutlineNeighbourhood(PixelPos, Center, Neighbours, FarNeighbours);

	const FThinOutlineEdges Edges = DetectEdges(Center, Neighbours, FarNeighbours);

	// Crease history. Sky has no surface to keep a crease record for.
	FThinOutlineRecord CreaseHorizontal = GetEmptyRecord();
	FThinOutlineRecord CreaseVertical = GetEmptyRecord();

	if (!Center.bIsSky && bHistoryValid != 0)
	{
		ReprojectCreaseRecords(ViewportPos, PixelPos, Center, CreaseHorizontal, CreaseVertical);
		DropRecordOutsideSamplingRange(CreaseHorizontal);
		DropRecordOutsideSamplingRange(CreaseVertical);
	}

	// Silhouette history, also on sky pixels, which are the background of a silhouette against the sky.
	const FThinOutlineForeground Foreground = FindForeground(PixelPos, Center, Neighbours, FarNeighbours);

	FThinOutlineRecord SilhouetteHorizontal = GetEmptyRecord();
	FThinOutlineRecord SilhouetteVertical = GetEmptyRecord();

	if (bHistoryValid != 0)
	{
		ReprojectSilhouetteRecords(ViewportPos, Foreground, SilhouetteHorizontal, SilhouetteVertical);
		DropRecordOutsideSamplingRange(SilhouetteHorizontal);
		DropRecordOutsideSamplingRange(SilhouetteVertical);
	}

	CreaseHorizontal.SampleCount *= SampleCountDecay;
	CreaseVertical.SampleCount *= SampleCountDecay;
	SilhouetteHorizontal.SampleCount *= SampleCountDecay;
	SilhouetteVertical.SampleCount *= SampleCountDecay;

	FThinOutlineRecord Horizontal;
	FThinOutlineRecord Vertical;
	uint HorizontalType;
	uint VerticalType;
	UpdateAxisRecord(CreaseHorizontal, SilhouetteHorizontal, SampleLocalPosition.xy,
		Edges.Crease[0], Edges.Crease[1], Edges.Silhouette[0], Edges.Silhouette[1], Horizontal, HorizontalType);
	UpdateAxisRecord(CreaseVertical, SilhouetteVertical, SampleLocalPosition.yx,
		Edges.Crease[2], Edges.Crease[3], Edges.Silhouette[2], Edges.Silhouette[3], Vertical, VerticalType);

	float4 A, B;
	PackRecord(Horizontal, HorizontalType, A, B);
	RWHorizontalA[ViewportPos] = A;
	RWHorizontalB[ViewportPos] = B;
	PackRecord(Vertical, VerticalType, A, B);
	RWVerticalA[ViewportPos] = A;
	RWVerticalB[ViewportPos] = B;
	RWSilhouetteKept[ViewportPos] = float2(
		HorizontalType == EDGE_SILHOUETTE ? Horizontal.KeptRatio : 0.0,
		VerticalType == EDGE_SILHOUETTE ? Vertical.KeptRatio : 0.0);

	// Zero never passes the depth tests, so sky does not hand out history.
	RWDepth[ViewportPos] = float2(Center.bIsSky ? 0.0 : Center.Depth, Foreground.bIsSky ? 0.0 : Foreground.Depth);
}
