/*=============================================================================
	ThinOutlineRecord.usf: updates the per-pixel edge records with this frame's jittered sample.

	The previous frame's records are fetched at the reprojected position and moved into this pixel's local coordinates,
	unless the history is rejected. Then this frame's edge checks add their samples.

	History reprojection (r.ThinOutline.Estimator.HistoryReprojection):
	- Nearest: the history pixel nearest to the reprojected position. A record only moves by whole pixels while its edge
	  moves by fractions, so under motion records slip past the edge (behind it when the fraction of the motion is below
	  half a pixel, ahead of it above), leave the pixels that can sample the edge, and linger there while they decay.
	- Bilinear: the four history pixels around the reprojected position, each moved into this pixel's coordinates and
	  merged with bilinear weights (their sample counts scaled by the weights), so records follow the edge continuously.
	- Range drop: a reprojected crease record whose edge has left the pixel's sampling range is dropped (see
	  DropRecordOutsideSamplingRange). Silhouette records have the background test instead (see MainCS).

	Each axis keeps one record, either a crease or a silhouette record. Both types belong to the surface under the pixel:
	silhouette records are kept by the foreground pixels of the contour. The history is fetched once, with the pixel's own
	velocity, except on the frames when the pixel samples the background next to the contour: it then takes the velocity
	of the foreground neighbour (see FindHistoryForeground), since the records it holds from the other frames belong to
	the foreground. Each history tap's record feeds the reprojected record of its own type.
	Crease records are kept while their depth matches the pixel's, and (CREASE_HISTORY_TEST) until a few frames pass
	without a crease found at the pixel along their axis (see UpdateCreaseMissCount).
	Silhouette records are kept while their foreground depth matches the pixel's or its foreground neighbour's, and while
	the background of the contour is still within two pixels toward the record's background side (see
	HasBackgroundInReach): when the contour slides over a curved surface, a record that moved with the surface ends up
	inside the foreground. Optionally (VIEW_ANGLE_TEST, r.ThinOutline.Silhouette.HistoryViewAngle > 0), they are also
	rejected when the view direction turns out of the plane through the camera and the edge by too much, relative to the
	surface with SURFACE_TURN.
	Then the axis keeps the record of one type (see UpdateAxisRecord).
	A record that fails a history test, or a crease record that meets a silhouette sample, is not dropped at once: its fade
	count (bad frames in a row) goes up while it is kept and drawn as before, and only at r.ThinOutline.Estimator.FadeFrames
	bad frames in a row is the record dropped or taken over. A pixel whose jittered sample lands on the other surface of a
	depth step or sliver, or misses an edge, on one frame of the jitter cycle then keeps its outline instead of losing the
	record and rebuilding it over several frames.
=============================================================================*/

#include "ThinOutlineCommon.ush"

Texture2D<float4> HistoryHorizontalA;
Texture2D<float4> HistoryHorizontalB;
Texture2D<float4> HistoryVerticalA;
Texture2D<float4> HistoryVerticalB;
// (kept ratio, kept ratio, foreground depth, foreground depth) of the (horizontal, vertical) records, if they are
// silhouette records. Foreground depths are scaled by THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE.
Texture2D<float4> HistorySilhouetteForeground;
// Linear depth of the pixel's surface.
Texture2D<float> HistoryDepth;

RWTexture2D<float4> RWHorizontalA;
RWTexture2D<float4> RWHorizontalB;
RWTexture2D<float4> RWVerticalA;
RWTexture2D<float4> RWVerticalB;
RWTexture2D<float4> RWSilhouetteForeground;
RWTexture2D<float> RWDepth;

// This frame's G-buffer sample position inside its rendering pixel, in pixel-local coordinates [0, 1]^2.
float2 SampleLocalPosition;
// 1 - decay rate, applied to the sample counts once per frame.
float SampleCountDecay;
// Relative depth tolerances of the history depth tests (the silhouette one is also the depth step of the background
// test with BACKGROUND_DEPTH_STEP).
float CreaseHistoryDepthThreshold;
float SilhouetteHistoryDepthThreshold;
// Sine of the largest angle the view direction may turn by out of the plane of a silhouette edge in one frame
// (VIEW_ANGLE_TEST).
float SilhouetteHistorySinAngle;
// A crease sample only takes over a silhouette record with fewer samples than this.
float SilhouetteCreaseTakeoverSampleCount;
// r.ThinOutline.Estimator.FadeFrames: bad frames in a row after which a record is dropped or taken over.
float FadeLimit;
// r.ThinOutline.Estimator.FadeMaxSpeed, in viewport pixels per frame: a pixel moving faster drops a record that fails a
// history test at once, and a silhouette sample takes its crease record over at once, as without fades, so that records
// do not trail moving edges and contours that move in are not held back.
float FadeMaxSpeed;
// Keep level of the crease history test (CREASE_HISTORY_TEST): the crease thresholds scaled by
// r.ThinOutline.Crease.HistoryCreaseTestThreshold; and the frames without a crease after which a crease record is
// dropped (r.ThinOutline.Crease.HistoryFramesWithoutCrease, or the jitter sequence length).
float CreaseHistoryKeepRidgeThreshold;
float CreaseHistoryKeepValleyThreshold;
float CreaseHistoryMissLimit;
uint bHistoryValid;
// Bit 0: drop records outside the sampling range. Bit 1: bilinear history instead of the nearest history pixel.
uint HistoryReprojectionMode;

#define HISTORY_RANGE_DROP 1
#define HISTORY_BILINEAR 2

float2 ViewportPosToScreenPos(int2 ViewportPos)
{
	return (float2(ViewportPos) + 0.5) * View.ViewSizeAndInvSize.zw * float2(2.0, -2.0) + float2(-1.0, 1.0);
}

// Screen velocity (and device Z velocity) of a pixel that did not draw velocity: camera motion only.
float3 ComputeStaticVelocity(float2 ScreenPos, float DeviceZ)
{
	const float3 PosN = float3(ScreenPos, DeviceZ);
	const float4 PrevClip = mul(float4(PosN, 1.0), View.ClipToPrevClip);
	return PosN - PrevClip.xyz / PrevClip.w;
}

float3 GetPixelVelocity(int2 PixelPos, float DeviceZ)
{
	const float4 EncodedVelocity = SceneTexturesStruct.GBufferVelocityTexture.Load(int3(PixelPos, 0));
	return EncodedVelocity.x > 0.0
		? DecodeVelocityFromTexture(EncodedVelocity)
		: ComputeStaticVelocity(ViewportPosToScreenPos(PixelPos - int2(View.ViewRectMin.xy)), DeviceZ);
}

// History pixels of a point at ScreenPos that moved by ScreenVelocity (see the top of the file), with their weights and
// this pixel's center relative to each one's center. Taps outside the view get no weight.
struct FThinOutlineHistoryTaps
{
	int2 Pixels[4];
	float2 Offsets[4];
	float Weights[4];
};

FThinOutlineHistoryTaps GetHistoryTaps(float2 ScreenPos, float2 ScreenVelocity)
{
	const float2 ViewSize = View.ViewSizeAndInvSize.xy;
	const float2 PrevViewportPos = ((ScreenPos - ScreenVelocity) * float2(0.5, -0.5) + 0.5) * ViewSize;

	FThinOutlineHistoryTaps Taps;
	const bool bBilinear = (HistoryReprojectionMode & HISTORY_BILINEAR) != 0;
	const float2 Corner = PrevViewportPos - 0.5;
	const int2 BasePixel = bBilinear ? int2(floor(Corner)) : int2(floor(PrevViewportPos));
	const float2 Fraction = Corner - float2(BasePixel);

	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const int2 Step = int2(Index & 1, Index >> 1);
		Taps.Pixels[Index] = BasePixel + Step;
		Taps.Offsets[Index] = PrevViewportPos - (float2(Taps.Pixels[Index]) + 0.5);

		const float2 AxisWeights = lerp(1.0 - Fraction, Fraction, float2(Step));
		Taps.Weights[Index] = bBilinear ? AxisWeights.x * AxisWeights.y : (Index == 0 ? 1.0 : 0.0);
		if (any(Taps.Pixels[Index] < 0) || any(Taps.Pixels[Index] >= int2(ViewSize)))
		{
			Taps.Weights[Index] = 0.0;
		}
	}
	return Taps;
}

// Merges one history record, moved into this pixel's coordinates, into the reprojected record with a weight: its
// samples keep their relative weights, scaled by Weight.
void AddHistoryRecord(inout FThinOutlineRecord Reprojected, FThinOutlineRecord Record, float2 Offset, float Weight)
{
	ShiftRecord(Record, Offset);
	Record.SampleCount *= Weight;
	Reprojected = MergeRecords(Reprojected, Record);
}

// The records of both axes of one history pixel, with their types.
void LoadHistoryRecords(
	int3 Texel,
	out FThinOutlineRecord HorizontalRecord,
	out uint HorizontalType,
	out FThinOutlineRecord VerticalRecord,
	out uint VerticalType)
{
	HorizontalRecord = UnpackRecord(HistoryHorizontalA.Load(Texel), HistoryHorizontalB.Load(Texel), HorizontalType);
	VerticalRecord = UnpackRecord(HistoryVerticalA.Load(Texel), HistoryVerticalB.Load(Texel), VerticalType);
}

// A pixel samples an edge only while the edge lies in the pixel or in one of its two neighbours along the axis, so its
// samples' u (trapezoid midlines 0.5 + E / 2 for an edge at u = E in (-1, 2)) lie in [0, 1.5]. A reprojected record whose
// midline leaves that range over the pixel's whole span across the axis (v in [0, 1]) describes an edge the pixel can no
// longer sample: dropped instead of lingering. The midline follows the record's own slope, since a slanted edge that
// moves across the axis keeps its mean u while its samples leave the pixel.
void DropRecordOutsideSamplingRange(inout FThinOutlineRecord Record)
{
	if ((HistoryReprojectionMode & HISTORY_RANGE_DROP) == 0 || Record.SampleCount <= 0.0)
	{
		return;
	}

	const float Slope = Record.Variance.y > THIN_OUTLINE_MIN_FIT_VARIANCE ? Record.Covariance / Record.Variance.y : 0.0;
	const float MidlineAtV0 = Record.Mean.x - Slope * Record.Mean.y;
	const float MidlineAtV1 = MidlineAtV0 + Slope;
	if (max(MidlineAtV0, MidlineAtV1) < 0.0 || min(MidlineAtV0, MidlineAtV1) > 1.5)
	{
		Record = GetEmptyRecord();
	}
}

// The pixel whose velocity moves this pixel's history: on the frames when the pixel samples the background of a
// silhouette, the nearest neighbour its background check fired toward (the foreground, whose records the pixel holds
// from the frames when it sampled the foreground); else the pixel itself.
struct FThinOutlineForeground
{
	int2 PixelPos;
	float DeviceZ;
	float Depth;
	// Whether the pixel is the background of a silhouette this frame.
	bool bFound;
};

FThinOutlineForeground FindHistoryForeground(int2 PixelPos, FThinOutlineSample Center, FThinOutlineSample Neighbours[4], FThinOutlineEdges Edges)
{
	FThinOutlineForeground Foreground;
	Foreground.PixelPos = PixelPos;
	Foreground.DeviceZ = Center.DeviceZ;
	Foreground.bFound = false;

	// Reversed Z: nearer is larger.
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		if (Edges.BackgroundSilhouette[Index] > 0.0 && (!Foreground.bFound || Neighbours[Index].DeviceZ > Foreground.DeviceZ))
		{
			Foreground.PixelPos = ClampToViewRect(PixelPos + NeighbourOffsets[Index]);
			Foreground.DeviceZ = Neighbours[Index].DeviceZ;
			Foreground.bFound = true;
		}
	}

	Foreground.Depth = DeviceZToDepth(Foreground.DeviceZ);
	return Foreground;
}

// Whether a reprojected silhouette record's foreground is still in place: the pixel itself, or its neighbour toward
// the record's foreground side, has the record's foreground depth. The pixel at the contour samples the background on
// some frames, and its foreground is then the neighbour. The neighbour depths are those of the first (left or top) and
// second (right or bottom) neighbour of the axis.
bool IsForegroundInPlace(FThinOutlineRecord Record, float CenterDepth, float FirstNeighbourDepth, float SecondNeighbourDepth)
{
	// Samples recorded through the first check have their background on the first side.
	const float NeighbourDepth = Record.KeptRatio >= 0.5 ? SecondNeighbourDepth : FirstNeighbourDepth;
	const float Tolerance = SilhouetteHistoryDepthThreshold * Record.ForegroundDepth;
	return any(abs(float2(CenterDepth, NeighbourDepth) - Record.ForegroundDepth) <= Tolerance);
}

// The directions (bit i for NeighbourOffsets[i]) in which the background of a silhouette is within reach: the pixel
// itself samples the background of a silhouette toward the opposite side, or the neighbour in that direction is behind
// a silhouette, or the pixel beyond it is. Two pixels, because the pixel at the contour samples the foreground on some
// frames, and its foreground neighbour's background is then two pixels away. A reprojected silhouette record is kept
// only while there is background toward its background side: one that has slid into the foreground, where its contour
// no longer is, finds none. Computed before the history fetch, so that the world positions are not held through it.
uint GetBackgroundInReachMask(FThinOutlineSample Center, FThinOutlineSample Neighbours[4], FThinOutlineSample FarNeighbours[4], FThinOutlineEdges Edges)
{
	uint Mask = 0;
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const FThinOutlineSample Neighbour = Neighbours[Index];
		const FThinOutlineSample Far = FarNeighbours[Index];

		// Two pixels away, seen from the neighbour N between them (a sky N is found by the checks, unless the pixel is sky
		// too: no contour around).
#if BACKGROUND_DEPTH_STEP
		// r.ThinOutline.Silhouette.HistoryBackgroundTest 1: a relative depth step.
		const bool bFarBackground = !Neighbour.bIsSky && Far.Depth > Neighbour.Depth * (1.0 + SilhouetteHistoryDepthThreshold);
#else
		// The silhouette measure seen from N, without its symmetric term (which would need the pixel three steps away):
		// the pixel beyond N is farther and off the line through this pixel and N.
		const bool bFarBackground = !Neighbour.bIsSky && (Far.bIsSky
			|| (Far.Depth > Neighbour.Depth && GetDistanceFromLine(Far.TranslatedWorldPosition, Center, Neighbour) > SilhouetteThreshold * Neighbour.Depth));
#endif
		if (Edges.BackgroundSilhouette[Index ^ 1] > 0.0 || Edges.Silhouette[Index] > 0.0 || bFarBackground)
		{
			Mask |= 1u << Index;
		}
	}
	return Mask;
}

// The directions (bit i for NeighbourOffsets[i]) in which this frame's crease check of the pixel reaches the keep level
// of the crease history test (CREASE_HISTORY_TEST): the crease measure above the ridge or valley threshold scaled by
// r.ThinOutline.Crease.HistoryCreaseTestThreshold, also on frames when the pixel has a silhouette and runs no crease
// checks.
uint GetNearCreaseMask(FThinOutlineEdges Edges)
{
	uint Mask = 0;
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		if (Edges.CreaseMeasure[Index] > (Edges.bRidge[Index] ? CreaseHistoryKeepRidgeThreshold : CreaseHistoryKeepValleyThreshold))
		{
			Mask |= 1u << Index;
		}
	}
	return Mask;
}

// The crease history test of one axis's reprojected crease record (CREASE_HISTORY_TEST): its count of frames since a
// crease was last found at the pixel along the axis restarts when one is found this frame, and the record is dropped
// when the count reaches CreaseHistoryMissLimit (r.ThinOutline.Crease.HistoryFramesWithoutCrease, 3; 1000 = in effect
// never; 0 = a jitter cycle).
// The depth test cannot see a record that slid along one depth-continuous surface (a foot's crease left on the floor it
// stood on, a junction's crease carried onto the curved wall next to it), since a crease joins two such surfaces by
// definition. Nor copies: the history only shifts records, so on a face that widens on screen (turning toward the
// camera) the pixels that came from within a pixel of a crease each get a record claiming it runs through their own
// pixel, and those near it draw. Not every frame, because a crease thinner than a pixel (a ledge seen edge-on) is only
// found on the frames when a sample lands on it, and the pixel on either side of a crease only on the frames when its
// own pair of pixels straddles it.
void UpdateCreaseMissCount(inout FThinOutlineRecord Record, bool bCreaseFound)
{
	if (Record.SampleCount <= 0.0)
	{
		return;
	}
	Record.ForegroundDepth = bCreaseFound ? 0.0 : Record.ForegroundDepth + 1.0;
	if (Record.ForegroundDepth >= CreaseHistoryMissLimit)
	{
		Record = GetEmptyRecord();
	}
}

// Whether a reprojected silhouette record of the axis whose first neighbour is FirstIndex (NeighbourOffsets order) has
// background within reach toward its background side (see GetBackgroundInReachMask).
bool HasBackgroundInReach(FThinOutlineRecord Record, uint FirstIndex, uint BackgroundInReachMask)
{
	// Samples recorded through the first check have their background on the first side.
	const uint BackgroundIndex = Record.KeptRatio >= 0.5 ? FirstIndex : FirstIndex + 1;
	return (BackgroundInReachMask & (1u << BackgroundIndex)) != 0;
}

// Translated world position, in the previous frame, of the surface point a pixel samples: the pixel's velocity moves it
// back on screen and in depth.
float3 GetPrevTranslatedWorldPosition(int2 PixelPos, float DeviceZ)
{
	const float3 Velocity = GetPixelVelocity(PixelPos, DeviceZ);
	const float2 PrevScreenPos = ViewportPosToScreenPos(PixelPos - int2(View.ViewRectMin.xy)) - Velocity.xy;
	const float PrevDepth = ConvertFromDeviceZ(DeviceZ - Velocity.z);
	return mul(float4(PrevScreenPos * PrevDepth, PrevDepth, 1.0), View.PrevScreenToTranslatedWorld).xyz;
}

// Last frame's view direction, turned along with the surface inside the contour since then, so that only the view's turn
// relative to the surface is left: an object turning in front of a still camera slides its contour too. The surface's
// turn is the rotation of the chord from the foreground pixel to the pixel one step further in, between where the
// velocities put its two points last frame and where they are now: the same surface points in both frames, so neither
// the jitter nor normal maps enter. A turn about the chord itself is lost, but near a contour the chord runs close to
// the line of sight, and a turn about the line of sight does not slide the contour. Without a second point on the same
// surface (parts one or two pixels thin) the view direction is returned unturned.
float3 TurnWithSurface(float3 PrevViewDirection, int2 ForegroundPixelPos, int2 InwardStep)
{
	// Only objects that draw velocity move by themselves; static geometry does not turn.
	BRANCH
	if (SceneTexturesStruct.GBufferVelocityTexture.Load(int3(ClampToViewRect(ForegroundPixelPos), 0)).x <= 0.0)
	{
		return PrevViewDirection;
	}

	const FThinOutlineSample Foreground = LoadDepthSample(ForegroundPixelPos);
	const FThinOutlineSample Inner = LoadDepthSample(ForegroundPixelPos + InwardStep);
	const FThinOutlineSample Beyond = LoadDepthSample(ForegroundPixelPos + 2 * InwardStep);

	// The inner pixel's surface, continued back to the foreground pixel, must pass through it (the silhouette measure
	// from N's side).
	const float Distance = GetDistanceFromLine(Foreground.TranslatedWorldPosition, Beyond, Inner);
	BRANCH
	if (Foreground.bIsSky || Inner.bIsSky || Distance < 0.0 || Distance > SilhouetteThreshold * Foreground.Depth)
	{
		return PrevViewDirection;
	}

	const float3 Chord = normalize(Inner.TranslatedWorldPosition - Foreground.TranslatedWorldPosition);
	const float3 PrevChord = normalize(
		GetPrevTranslatedWorldPosition(ClampToViewRect(ForegroundPixelPos + InwardStep), Inner.DeviceZ)
		- GetPrevTranslatedWorldPosition(ClampToViewRect(ForegroundPixelPos), Foreground.DeviceZ));

	// Rotation taking PrevChord to Chord (Rodrigues' formula with the unnormalized axis). A chord that turned by more than
	// 120 degrees in a frame is not a surface turning.
	const float3 Axis = cross(PrevChord, Chord);
	const float CosAngle = dot(PrevChord, Chord);
	if (CosAngle <= -0.5)
	{
		return PrevViewDirection;
	}
	return PrevViewDirection * CosAngle + cross(Axis, PrevViewDirection) + Axis * (dot(Axis, PrevViewDirection) / (1.0 + CosAngle));
}

// Whether the view direction turned out of the plane through the camera and the record's edge by more than the
// threshold angle since the previous frame. At a smooth contour that plane is the surface's tangent plane: turning the
// view direction within it moves the contour along itself, turning it out of it slides the contour over the surface.
// Ray is the current view direction through this pixel (any length), PrevViewDirection the previous one (unit length).
bool HasViewLeftEdgePlane(FThinOutlineRecord Record, bool bVerticalAxis, float3 Ray, float3 PrevViewDirection)
{
	// Edge direction in viewport pixels: the edge u = 2 (a + b v) - 1 moves by 2b along the axis per pixel across it.
	const float Slope = Record.Variance.y > THIN_OUTLINE_MIN_FIT_VARIANCE ? Record.Covariance / Record.Variance.y : 0.0;
	const float2 EdgeStep = bVerticalAxis ? float2(1.0, 2.0 * Slope) : float2(2.0 * Slope, 1.0);

	// The rays through this pixel and through a point along the edge span the plane.
	const float2 ScreenStep = EdgeStep * View.ViewSizeAndInvSize.zw * float2(2.0, -2.0);
	const float3 RayStep = mul(float4(ScreenStep, 0.0, 0.0), View.ScreenToTranslatedWorld).xyz;
	const float3 EdgePlaneNormal = normalize(cross(Ray, RayStep));
	return abs(dot(EdgePlaneNormal, PrevViewDirection)) > SilhouetteHistorySinAngle;
}

// The view-angle test of one axis's reprojected silhouette record (VIEW_ANGLE_TEST), relative to the surface
// (TurnWithSurface) when SURFACE_TURN is set. ForegroundPixelPos: the pixel whose velocity moved the history.
bool HasViewTurnedOffContour(FThinOutlineRecord Record, bool bVerticalAxis, int2 ForegroundPixelPos, float3 Ray, float3 PrevViewDirection)
{
#if SURFACE_TURN
	// Into the foreground: away from the record's background side (the first side when the kept ratio is at least 0.5).
	const int2 AxisStep = bVerticalAxis ? int2(0, 1) : int2(1, 0);
	const int2 InwardStep = Record.KeptRatio >= 0.5 ? AxisStep : -AxisStep;
	const float3 RelativePrevViewDirection = TurnWithSurface(PrevViewDirection, ForegroundPixelPos, InwardStep);
	return HasViewLeftEdgePlane(Record, bVerticalAxis, Ray, RelativePrevViewDirection);
#else
	// r.ThinOutline.Silhouette.HistorySurfaceTurn 0: the view direction's own turn only.
	return HasViewLeftEdgePlane(Record, bVerticalAxis, Ray, PrevViewDirection);
#endif
}

// A history tap that fails its depth test is still merged, at this fraction of its weight: next to a tap that passes it
// changes nothing, and alone it keeps the record, which then fades (UpdateAxisRecord) instead of being dropped.
#define FAILED_TAP_WEIGHT 1.0e-3

// A reprojected record made only of taps that failed their depth test: their weights are restored, and it counts as
// failed.
bool RestoreFailedRecord(inout FThinOutlineRecord Record, float PassedWeight)
{
	const bool bFailed = Record.SampleCount > 0.0 && PassedWeight <= 0.0;
	if (bFailed)
	{
		Record.SampleCount /= FAILED_TAP_WEIGHT;
	}
	return bFailed;
}

// Fetches the previous frame's records with the velocity of the history foreground (see FindHistoryForeground), moved
// into this pixel's local coordinates, and applies the history tests. A record that fails them is kept and reported
// as failed (see the top of the file); the view-angle test, the range drop and the crease miss limit still drop it.
void ReprojectHistory(
	int2 ViewportPos,
	int2 PixelPos,
	FThinOutlineForeground Foreground,
	FThinOutlineSample Center,
	FThinOutlineSample Neighbours[4],
	uint BackgroundInReachMask,
	uint NearCreaseMask,
	out FThinOutlineRecord CreaseHorizontal,
	out FThinOutlineRecord CreaseVertical,
	out FThinOutlineRecord SilhouetteHorizontal,
	out FThinOutlineRecord SilhouetteVertical,
	out bool bCreaseHorizontalFailed,
	out bool bCreaseVerticalFailed,
	out bool bSilhouetteHorizontalFailed,
	out bool bSilhouetteVerticalFailed,
	out float FailedCreaseDepth,
	out bool bMoving)
{
	CreaseHorizontal = GetEmptyRecord();
	CreaseVertical = GetEmptyRecord();
	SilhouetteHorizontal = GetEmptyRecord();
	SilhouetteVertical = GetEmptyRecord();
	bCreaseHorizontalFailed = false;
	bCreaseVerticalFailed = false;
	bSilhouetteHorizontalFailed = false;
	bSilhouetteVerticalFailed = false;
	FailedCreaseDepth = 0.0;
	bMoving = false;

	// Sky has no surface to keep records for, unless it is the background next to a foreground this frame.
	if (Center.bIsSky && !Foreground.bFound)
	{
		return;
	}

	const float3 Velocity = GetPixelVelocity(Foreground.PixelPos, Foreground.DeviceZ);
	const float2 ScreenPos = ViewportPosToScreenPos(ViewportPos);
	const FThinOutlineHistoryTaps Taps = GetHistoryTaps(ScreenPos, Velocity.xy);

	// Expected depth of this pixel's surface in the previous frame, for the crease records. A crease lies on a
	// depth-continuous surface, so a history pixel of the same surface only differs by the depth change across the
	// jitter, up to about a pixel's step, which the threshold has to cover on surfaces seen at a grazing angle.
	float OwnVelocityZ = Velocity.z;
	BRANCH
	if (Foreground.bFound && !Center.bIsSky)
	{
		OwnVelocityZ = GetPixelVelocity(PixelPos, Center.DeviceZ).z;
	}
	const float PrevDepth = ConvertFromDeviceZ(Center.DeviceZ - OwnVelocityZ);
	const float CreaseTolerance = CreaseHistoryDepthThreshold * PrevDepth;

	// The silhouette records' foreground depths are last frame's; the foreground moved in depth like the pixel whose
	// velocity is used.
	const float DepthShift = ConvertFromDeviceZ(Foreground.DeviceZ - Velocity.z) - Foreground.Depth;

	// Bilinear weight of the taps that passed their depth test, per record; depth of the crease taps that failed it.
	float FailedCreaseDepthSum = 0.0;
	float FailedCreaseWeight = 0.0;
	float CreaseHorizontalPassed = 0.0;
	float CreaseVerticalPassed = 0.0;
	float SilhouetteHorizontalPassed = 0.0;
	float SilhouetteVerticalPassed = 0.0;

	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const int3 Texel = int3(Taps.Pixels[Index], 0);

		BRANCH
		if (Taps.Weights[Index] > 0.0)
		{
			FThinOutlineRecord TapHorizontal;
			FThinOutlineRecord TapVertical;
			uint HorizontalType;
			uint VerticalType;
			LoadHistoryRecords(Texel, TapHorizontal, HorizontalType, TapVertical, VerticalType);

			// Sky has no surface to keep a crease record for.
			const bool bHorizontalCrease = !Center.bIsSky && HorizontalType == EDGE_CREASE && TapHorizontal.SampleCount > 0.0;
			const bool bVerticalCrease = !Center.bIsSky && VerticalType == EDGE_CREASE && TapVertical.SampleCount > 0.0;

			BRANCH
			if (bHorizontalCrease || bVerticalCrease)
			{
				const float TapDepth = HistoryDepth.Load(Texel);
				const bool bKeep = abs(TapDepth - PrevDepth) <= CreaseTolerance;
#if CREASE_HISTORY_TEST
				// The frames since a crease was last found (see UpdateCreaseMissCount), merged like the other values.
				const float4 TapMissCounts = HistorySilhouetteForeground.Load(Texel);
				TapHorizontal.ForegroundDepth = TapMissCounts.z;
				TapVertical.ForegroundDepth = TapMissCounts.w;
#endif
				if (bHorizontalCrease)
				{
					AddHistoryRecord(CreaseHorizontal, TapHorizontal, Taps.Offsets[Index].xy, Taps.Weights[Index] * (bKeep ? 1.0 : FAILED_TAP_WEIGHT));
					CreaseHorizontalPassed += bKeep ? Taps.Weights[Index] : 0.0;
				}
				if (bVerticalCrease)
				{
					AddHistoryRecord(CreaseVertical, TapVertical, Taps.Offsets[Index].yx, Taps.Weights[Index] * (bKeep ? 1.0 : FAILED_TAP_WEIGHT));
					CreaseVerticalPassed += bKeep ? Taps.Weights[Index] : 0.0;
				}
				FailedCreaseDepthSum += bKeep ? 0.0 : TapDepth * Taps.Weights[Index];
				FailedCreaseWeight += bKeep ? 0.0 : Taps.Weights[Index];
			}

			BRANCH
			if (HorizontalType == EDGE_SILHOUETTE || VerticalType == EDGE_SILHOUETTE)
			{
				const float4 TapForeground = HistorySilhouetteForeground.Load(Texel);
				TapHorizontal.KeptRatio = TapForeground.x;
				TapVertical.KeptRatio = TapForeground.y;
				TapHorizontal.ForegroundDepth = TapForeground.z / THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE - DepthShift;
				TapVertical.ForegroundDepth = TapForeground.w / THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE - DepthShift;

				if (HorizontalType == EDGE_SILHOUETTE)
				{
					const bool bKeep = IsForegroundInPlace(TapHorizontal, Center.Depth, Neighbours[0].Depth, Neighbours[1].Depth);
					AddHistoryRecord(SilhouetteHorizontal, TapHorizontal, Taps.Offsets[Index].xy, Taps.Weights[Index] * (bKeep ? 1.0 : FAILED_TAP_WEIGHT));
					SilhouetteHorizontalPassed += bKeep ? Taps.Weights[Index] : 0.0;
				}
				if (VerticalType == EDGE_SILHOUETTE)
				{
					const bool bKeep = IsForegroundInPlace(TapVertical, Center.Depth, Neighbours[2].Depth, Neighbours[3].Depth);
					AddHistoryRecord(SilhouetteVertical, TapVertical, Taps.Offsets[Index].yx, Taps.Weights[Index] * (bKeep ? 1.0 : FAILED_TAP_WEIGHT));
					SilhouetteVerticalPassed += bKeep ? Taps.Weights[Index] : 0.0;
				}
			}
		}
	}

	bCreaseHorizontalFailed = RestoreFailedRecord(CreaseHorizontal, CreaseHorizontalPassed);
	bCreaseVerticalFailed = RestoreFailedRecord(CreaseVertical, CreaseVerticalPassed);
	bSilhouetteHorizontalFailed = RestoreFailedRecord(SilhouetteHorizontal, SilhouetteHorizontalPassed);
	bSilhouetteVerticalFailed = RestoreFailedRecord(SilhouetteVertical, SilhouetteVerticalPassed);
	FailedCreaseDepth = FailedCreaseWeight > 0.0 ? FailedCreaseDepthSum / FailedCreaseWeight : 0.0;

#if CREASE_HISTORY_TEST
	UpdateCreaseMissCount(CreaseHorizontal, (NearCreaseMask & 0x3u) != 0);
	UpdateCreaseMissCount(CreaseVertical, (NearCreaseMask & 0xCu) != 0);
#endif

	if (SilhouetteHorizontal.SampleCount > 0.0 && !HasBackgroundInReach(SilhouetteHorizontal, 0, BackgroundInReachMask))
	{
		bSilhouetteHorizontalFailed = true;
	}
	if (SilhouetteVertical.SampleCount > 0.0 && !HasBackgroundInReach(SilhouetteVertical, 2, BackgroundInReachMask))
	{
		bSilhouetteVerticalFailed = true;
	}

	// Moving pixels drop failed records at once.
	bMoving = length(Velocity.xy * View.ViewSizeAndInvSize.xy * 0.5) >= FadeMaxSpeed;
	BRANCH
	if (bMoving)
	{
		if (bCreaseHorizontalFailed)
		{
			CreaseHorizontal = GetEmptyRecord();
			bCreaseHorizontalFailed = false;
		}
		if (bCreaseVerticalFailed)
		{
			CreaseVertical = GetEmptyRecord();
			bCreaseVerticalFailed = false;
		}
		if (bSilhouetteHorizontalFailed)
		{
			SilhouetteHorizontal = GetEmptyRecord();
			bSilhouetteHorizontalFailed = false;
		}
		if (bSilhouetteVerticalFailed)
		{
			SilhouetteVertical = GetEmptyRecord();
			bSilhouetteVerticalFailed = false;
		}
	}

#if VIEW_ANGLE_TEST
	BRANCH
	if (SilhouetteHorizontal.SampleCount > 0.0 || SilhouetteVertical.SampleCount > 0.0)
	{
		// Translated world view directions. Directions do not depend on the frame's translation, so they can be compared.
		const float3 Ray = mul(float4(ScreenPos, 1.0, 0.0), View.ScreenToTranslatedWorld).xyz;
		const float3 PrevViewDirection = normalize(mul(float4(ScreenPos - Velocity.xy, 1.0, 0.0), View.PrevScreenToTranslatedWorld).xyz);

		BRANCH
		if (SilhouetteHorizontal.SampleCount > 0.0)
		{
			if (HasViewTurnedOffContour(SilhouetteHorizontal, false, Foreground.PixelPos, Ray, PrevViewDirection))
			{
				SilhouetteHorizontal = GetEmptyRecord();
			}
		}
		BRANCH
		if (SilhouetteVertical.SampleCount > 0.0)
		{
			if (HasViewTurnedOffContour(SilhouetteVertical, true, Foreground.PixelPos, Ray, PrevViewDirection))
			{
				SilhouetteVertical = GetEmptyRecord();
			}
		}
	}
#endif
}

// Adds this frame's samples of the two checks of one axis. The first (left or top) check's samples are kept as they
// are, the second (right or bottom) check's samples are moved by +0.5 along the axis. ForegroundDepth: the pixel's
// depth (silhouettes only).
void AddAxisSamples(inout FThinOutlineRecord Record, float2 Sample, float FirstStrength, float SecondStrength, float ForegroundDepth)
{
	if (FirstStrength > 0.0)
	{
		AddRecordSample(Record, Sample, 1.0, FirstStrength, ForegroundDepth);
	}
	if (SecondStrength > 0.0)
	{
		AddRecordSample(Record, Sample + float2(0.5, 0.0), 0.0, SecondStrength, ForegroundDepth);
	}
}

void FinalizeRecord(inout FThinOutlineRecord Record)
{
	if (Record.SampleCount < THIN_OUTLINE_EMPTY_SAMPLE_COUNT)
	{
		Record = GetEmptyRecord();
	}
}

// Picks the record one axis keeps from its reprojected crease and silhouette records (already decayed), and adds this
// frame's samples of that type. A crease sample only takes over a silhouette record that has faded below
// SilhouetteCreaseTakeoverSampleCount, and is ignored otherwise: the pixel at the contour samples the foreground, which
// may have creases, on some frames and the background on others. A silhouette history that holds still wins over a
// crease history.
// Fade counts: a record's count of bad frames in a row goes up when it failed a history test this frame (bFailed) or, for
// a crease record, when a silhouette sample arrives; it restarts at 0 on any other frame. At FadeLimit the record is
// dropped. So a silhouette sample only takes over a crease record after FadeLimit frames in a row, or at once on a moving
// pixel (bMoving): sporadic silhouette samples on an edge sampled mostly as a crease do not reset its record, while a
// contour that moves in takes over. A crease sample does not count against a silhouette record, for the reason above.
void UpdateAxisRecord(
	bool bMoving,
	FThinOutlineRecord CreaseRecord,
	bool bCreaseFailed,
	FThinOutlineRecord SilhouetteRecord,
	bool bSilhouetteFailed,
	float2 Sample,
	float FirstCrease,
	float SecondCrease,
	float FirstSilhouette,
	float SecondSilhouette,
	float CenterDepth,
	out FThinOutlineRecord Record,
	out uint EdgeType)
{
	const bool bSilhouetteSample = max(FirstSilhouette, SecondSilhouette) > 0.0;
	const bool bCreaseSample = max(FirstCrease, SecondCrease) > 0.0;

	const float CreaseBadFrame = bSilhouetteSample && bMoving ? FadeLimit : 1.0;
	CreaseRecord.FadeCount = bCreaseFailed || bSilhouetteSample ? CreaseRecord.FadeCount + CreaseBadFrame : 0.0;
	SilhouetteRecord.FadeCount = bSilhouetteFailed ? SilhouetteRecord.FadeCount + 1.0 : 0.0;
	if (CreaseRecord.FadeCount >= FadeLimit)
	{
		CreaseRecord = GetEmptyRecord();
	}
	if (SilhouetteRecord.FadeCount >= FadeLimit)
	{
		SilhouetteRecord = GetEmptyRecord();
	}

	const bool bSilhouetteHolds = SilhouetteRecord.SampleCount > 0.0 && SilhouetteRecord.SampleCount >= SilhouetteCreaseTakeoverSampleCount;

	if (bSilhouetteHolds || (bSilhouetteSample && CreaseRecord.SampleCount <= 0.0))
	{
		// A silhouette check fires on the foreground pixel, toward the background.
		Record = SilhouetteRecord;
		EdgeType = EDGE_SILHOUETTE;
		AddAxisSamples(Record, Sample, FirstSilhouette, SecondSilhouette, CenterDepth);
	}
	else if (bCreaseSample || CreaseRecord.SampleCount > 0.0)
	{
		Record = CreaseRecord;
		EdgeType = EDGE_CREASE;
		AddAxisSamples(Record, Sample, FirstCrease, SecondCrease, 0.0);
	}
	else
	{
		// A faded silhouette record, if any, decays on.
		Record = SilhouetteRecord;
		EdgeType = EDGE_SILHOUETTE;
	}

	FinalizeRecord(Record);
}

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	const int2 ViewportPos = int2(DispatchThreadId);
	if (any(ViewportPos >= int2(View.ViewSizeAndInvSize.xy)))
	{
		return;
	}

	const int2 PixelPos = int2(View.ViewRectMin.xy) + ViewportPos;

	FThinOutlineSample Center;
	FThinOutlineSample Neighbours[4];
	FThinOutlineSample FarNeighbours[4];
	LoadOutlineNeighbourhood(PixelPos, Center, Neighbours, FarNeighbours);

	const FThinOutlineEdges Edges = DetectEdges(Center, Neighbours, FarNeighbours);

	FThinOutlineRecord CreaseHorizontal = GetEmptyRecord();
	FThinOutlineRecord CreaseVertical = GetEmptyRecord();
	FThinOutlineRecord SilhouetteHorizontal = GetEmptyRecord();
	FThinOutlineRecord SilhouetteVertical = GetEmptyRecord();
	bool bCreaseHorizontalFailed = false;
	bool bCreaseVerticalFailed = false;
	bool bSilhouetteHorizontalFailed = false;
	bool bSilhouetteVerticalFailed = false;
	float FailedCreaseDepth = 0.0;
	bool bMoving = false;
	if (bHistoryValid != 0)
	{
		const uint BackgroundInReachMask = GetBackgroundInReachMask(Center, Neighbours, FarNeighbours, Edges);
		const uint NearCreaseMask = GetNearCreaseMask(Edges);
		const FThinOutlineForeground Foreground = FindHistoryForeground(PixelPos, Center, Neighbours, Edges);
		ReprojectHistory(ViewportPos, PixelPos, Foreground, Center, Neighbours, BackgroundInReachMask, NearCreaseMask,
			CreaseHorizontal, CreaseVertical, SilhouetteHorizontal, SilhouetteVertical,
			bCreaseHorizontalFailed, bCreaseVerticalFailed, bSilhouetteHorizontalFailed, bSilhouetteVerticalFailed, FailedCreaseDepth, bMoving);
		// Silhouette records are bounded by the background test instead: the bilinear history spreads a moving contour's
		// records over one more pixel each frame, and the range drop cut the share that lands one pixel inside the
		// foreground (a tenth of the silhouette under a steady pan) although its contour is still next to it.
		DropRecordOutsideSamplingRange(CreaseHorizontal);
		DropRecordOutsideSamplingRange(CreaseVertical);
	}

	CreaseHorizontal.SampleCount *= SampleCountDecay;
	CreaseVertical.SampleCount *= SampleCountDecay;
	SilhouetteHorizontal.SampleCount *= SampleCountDecay;
	SilhouetteVertical.SampleCount *= SampleCountDecay;

	FThinOutlineRecord Horizontal;
	FThinOutlineRecord Vertical;
	uint HorizontalType;
	uint VerticalType;
	UpdateAxisRecord(bMoving, CreaseHorizontal, bCreaseHorizontalFailed, SilhouetteHorizontal, bSilhouetteHorizontalFailed, SampleLocalPosition.xy,
		Edges.Crease[0], Edges.Crease[1], Edges.Silhouette[0], Edges.Silhouette[1], Center.Depth,
		Horizontal, HorizontalType);
	UpdateAxisRecord(bMoving, CreaseVertical, bCreaseVerticalFailed, SilhouetteVertical, bSilhouetteVerticalFailed, SampleLocalPosition.yx,
		Edges.Crease[2], Edges.Crease[3], Edges.Silhouette[2], Edges.Silhouette[3], Center.Depth,
		Vertical, VerticalType);

	float4 A, B;
	PackRecord(Horizontal, HorizontalType, A, B);
	RWHorizontalA[ViewportPos] = A;
	RWHorizontalB[ViewportPos] = B;
	PackRecord(Vertical, VerticalType, A, B);
	RWVerticalA[ViewportPos] = A;
	RWVerticalB[ViewportPos] = B;

	// Silhouette records: kept ratio and foreground depth. Crease records: their frame counts of the crease history test.
	const bool bHorizontalSilhouette = HorizontalType == EDGE_SILHOUETTE && Horizontal.SampleCount > 0.0;
	const bool bVerticalSilhouette = VerticalType == EDGE_SILHOUETTE && Vertical.SampleCount > 0.0;
#if CREASE_HISTORY_TEST
	const float HorizontalCreaseMisses = HorizontalType == EDGE_CREASE ? Horizontal.ForegroundDepth : 0.0;
	const float VerticalCreaseMisses = VerticalType == EDGE_CREASE ? Vertical.ForegroundDepth : 0.0;
#else
	const float HorizontalCreaseMisses = 0.0;
	const float VerticalCreaseMisses = 0.0;
#endif
	RWSilhouetteForeground[ViewportPos] = float4(
		bHorizontalSilhouette ? Horizontal.KeptRatio : 0.0,
		bVerticalSilhouette ? Vertical.KeptRatio : 0.0,
		bHorizontalSilhouette ? Horizontal.ForegroundDepth * THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE : HorizontalCreaseMisses,
		bVerticalSilhouette ? Vertical.ForegroundDepth * THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE : VerticalCreaseMisses);

	// A crease record kept through a failed depth test belongs to the surface it was recorded on, so that surface's depth
	// is stored with it: tested against this frame's depth next frame, it would pass and the record would be adopted by
	// the surface the pixel shows now. Unless the other axis keeps a crease record of this surface (one depth per pixel).
	const bool bHorizontalFailedCrease = HorizontalType == EDGE_CREASE && Horizontal.SampleCount > 0.0 && bCreaseHorizontalFailed && Horizontal.FadeCount > 0.0;
	const bool bVerticalFailedCrease = VerticalType == EDGE_CREASE && Vertical.SampleCount > 0.0 && bCreaseVerticalFailed && Vertical.FadeCount > 0.0;
	const bool bHorizontalCurrentCrease = HorizontalType == EDGE_CREASE && Horizontal.SampleCount > 0.0 && !bHorizontalFailedCrease;
	const bool bVerticalCurrentCrease = VerticalType == EDGE_CREASE && Vertical.SampleCount > 0.0 && !bVerticalFailedCrease;
	const bool bKeepFailedDepth = (bHorizontalFailedCrease || bVerticalFailedCrease) && !bHorizontalCurrentCrease && !bVerticalCurrentCrease;

	// Zero never passes the depth test, so sky does not hand out crease history.
	RWDepth[ViewportPos] = Center.bIsSky ? 0.0 : (bKeepFailedDepth ? FailedCreaseDepth : Center.Depth);
}
