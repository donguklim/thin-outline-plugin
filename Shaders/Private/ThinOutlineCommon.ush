/*=============================================================================
	ThinOutlineCommon.ush: G-buffer edge checks and the temporal OLS edge records shared by the ThinOutline passes.

	Edge checks, for a target pixel C, each axial neighbour N (left, right, top, bottom), O, the pixel on the
	opposite side of C, and F, the pixel beyond N:

	Silhouette (world positions P of the pixels' samples, linear depth D, i.e. distance from the camera plane):
		Measure = min(distance of P_N from the line through P_O and P_C,
		              distance of P_C from the line through P_F and P_N) / D_C
		O, C, N and F lie on one screen axis, so on a plane they lie on one line in the world whatever the viewing angle:
		a surface seen at a grazing angle needs a larger depth step than a facing one to count as a silhouette.
		The second term (r.ThinOutline.Silhouette.SymmetricMeasure) continues N's surface back to C: where it passes
		through C, the two surfaces meet (a wall standing on a floor seen at a grazing angle) instead of N's hiding C's.
		No measure (0) when O is sky (C is then the foreground of a silhouette toward O, which says nothing about N) or
		when O is C itself (clamped at the view rect border). Without F (sky, or N itself at the border) only the first
		term counts.
		The check that records samples is the foreground pixel's (C nearer than N): it fires toward the background. The
		background pixel's check (C farther than N, firing toward the foreground) is evaluated too: it decides which
		pixel's velocity moves the history, and finds the foreground of a painted silhouette.
		A sky pixel (no depth) is a full silhouette background toward every non-sky axial neighbour, and a non-sky pixel a
		full silhouette foreground toward a sky neighbour.
		The same measure, with the silhouette threshold, decides everywhere else whether two pixels are on one surface.

	Crease (world normals):
		Measure = min(|cross(C, N) - cross(O, C)|, |cross(C, N)|)
		Ridges (convex) and valleys (concave) use separate thresholds.
		A strength only when the pixel has no silhouette (on either side); the measure itself is also kept for the crease
		history test of ThinOutlineRecord.usf.

	Strength = Measure > Threshold ? saturate((Measure - Threshold) * Scale) : 0

	Edge records, one per inducer axis (horizontal = left/right checks, vertical = top/bottom checks), each either a
	crease or a silhouette record (a pixel draws one or the other):
	Every frame, a check that fires adds this frame's jittered sample position (u, v) to the record of its axis, in
	pixel-local coordinates [0, 1]^2. u is the coordinate along the axis (x for horizontal), v the other one.
	Samples of the left (top) check are added as they are, samples of the right (bottom) check are moved by +0.5
	along u. For an edge u = E crossing the pixel, both land on the trapezoid midline u = 0.5 + E / 2, so ordinary
	least squares u = a + b v of the record gives the edge E = 2a - 1 + 2b v.
	The statistics are decayed running averages: every frame, the sample count n is multiplied by (1 - d), and a new
	sample is averaged in with weight 1 / n, so samples are weighted by (1 - d)^age.
	A silhouette is only sampled by its foreground pixels, through the check facing the background, so the fraction
	of samples that came through the left (top) check says on which side the background is (the left or top when it
	is at least 0.5). The records move with the foreground's velocity, like the surface they lie on. Silhouette
	records also keep the mean depth of their own pixel when it sampled them, i.e. of the foreground, which their
	history depth test uses.
=============================================================================*/

#pragma once

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Engine/Private/Substrate/Substrate.ush"

float SilhouetteThreshold;
float SilhouetteScale;
// Whether the depth edge measure also continues N's surface back to C (see above).
uint bSymmetricDepthMeasure;
float CreaseRidgeThreshold;
float CreaseValleyThreshold;
float CreaseScale;
// r.ThinOutline.Crease.SpikeFilter: the crease checks skip a one-pixel spike of the normal field, a pixel whose normal
// differs from both of its neighbours along the axis while those two agree with each other (|cross| of their normals
// below CreaseSpikeThreshold) and lie on one plane (the far one's sample within CreaseSpikePlaneTolerance × depth of the
// near one's plane: a groove's two sides do, a step's two risers do not). See DetectEdges.
uint bCreaseSpikeFilter;
float CreaseSpikeThreshold;
float CreaseSpikePlaneTolerance;

// Whether the spike filter is compiled in (it loads the normal of a pixel two steps away where a crease check fired):
// the record pass's permutation (r.ThinOutline.Crease.SpikeFilter) and the composites' debug views.
#ifndef CREASE_SPIKE_FILTER
#define CREASE_SPIKE_FILTER 0
#endif

// Linear depth used for pixels on the far plane (sky), so they act as the farthest background.
#define THIN_OUTLINE_FAR_DEPTH 1.0e20

// Records with fewer (decayed) samples than this are cleared, so a record is either empty or holds real data.
#define THIN_OUTLINE_EMPTY_SAMPLE_COUNT 0.1

// OLS needs at least 3 samples for a standard error, and some spread across the axis.
#define THIN_OUTLINE_MIN_FIT_SAMPLE_COUNT 3.0
#define THIN_OUTLINE_MIN_FIT_VARIANCE 1.0e-4

// An outline band crosses a pixel when it covers more than this fraction of it. Rounding leaves a band that only touches
// the pixel with a tiny area of either sign; such a band must not win the edge selection over one that covers the pixel.
#define THIN_OUTLINE_MIN_BAND_AREA 1.0e-4

// Ordered so that (Index ^ 1) is the opposite neighbour: left, right, top, bottom.
static const int2 NeighbourOffsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };

//------------------------------------------------------- VELOCITY

float2 ViewportPosToScreenPos(int2 ViewportPos)
{
	return (float2(ViewportPos) + 0.5) * View.ViewSizeAndInvSize.zw * float2(2.0, -2.0) + float2(-1.0, 1.0);
}

// Screen velocity (and device Z velocity) of a pixel that did not draw velocity: camera motion only.
float3 ComputeStaticVelocity(float2 ScreenPos, float DeviceZ)
{
	const float3 PosN = float3(ScreenPos, DeviceZ);
	const float4 PrevClip = mul(float4(PosN, 1.0), View.ClipToPrevClip);
	return PosN - PrevClip.xyz / PrevClip.w;
}

float3 GetPixelVelocity(int2 PixelPos, float DeviceZ)
{
	const float4 EncodedVelocity = SceneTexturesStruct.GBufferVelocityTexture.Load(int3(PixelPos, 0));
	return EncodedVelocity.x > 0.0
		? DecodeVelocityFromTexture(EncodedVelocity)
		: ComputeStaticVelocity(ViewportPosToScreenPos(PixelPos - int2(View.ViewRectMin.xy)), DeviceZ);
}

//------------------------------------------------------- EDGE CHECKS

struct FThinOutlineSample
{
	float DeviceZ;
	// Linear depth: distance from the camera plane.
	float Depth;
	float3 WorldNormal;
	float3 TranslatedWorldPosition;
	// Nothing was drawn: the depth buffer is still at the (infinite) far plane.
	bool bIsSky;
	// False for sky, unlit and other pixels without a G-buffer normal. Such pixels never get creases.
	bool bHasNormal;
};

bool IsSkyDeviceZ(float DeviceZ)
{
	return DeviceZ <= 1e-7;
}

float DeviceZToDepth(float DeviceZ)
{
	return IsSkyDeviceZ(DeviceZ) ? THIN_OUTLINE_FAR_DEPTH : ConvertFromDeviceZ(DeviceZ);
}

// Depth and G-buffer are addressed with the scene renderer's view rect.
int2 ClampToViewRect(int2 PixelPos)
{
	const int2 ViewRectMin = int2(View.ViewRectMin.xy);
	const int2 ViewRectMax = ViewRectMin + int2(View.ViewSizeAndInvSize.xy) - 1;
	return clamp(PixelPos, ViewRectMin, ViewRectMax);
}

float LoadDeviceZ(int2 PixelPos)
{
	return SceneTexturesStruct.SceneDepthTexture.Load(int3(ClampToViewRect(PixelPos), 0)).r;
}

// Depth and world position of a pixel (clamped to the view rect), without its normal.
FThinOutlineSample LoadDepthSample(int2 PixelPos)
{
	const int2 ClampedPos = ClampToViewRect(PixelPos);

	FThinOutlineSample Sample;
	Sample.DeviceZ = SceneTexturesStruct.SceneDepthTexture.Load(int3(ClampedPos, 0)).r;
	Sample.bIsSky = IsSkyDeviceZ(Sample.DeviceZ);
	Sample.Depth = DeviceZToDepth(Sample.DeviceZ);
	// The point the jittered projection sampled: the ray through the pixel's center, at the linear depth. (The engine's
	// ScreenToTranslatedWorld reconstruction: a 4x3 transform without the division of SvPositionToTranslatedWorld, and the
	// linear depth is needed anyway.)
	const float2 ScreenPos = (float2(ClampedPos - int2(View.ViewRectMin.xy)) + 0.5) * View.ViewSizeAndInvSize.zw * float2(2.0, -2.0) + float2(-1.0, 1.0);
	Sample.TranslatedWorldPosition = Sample.bIsSky ? float3(0, 0, 0) : mul(float4(ScreenPos * Sample.Depth, Sample.Depth, 1.0), View.ScreenToTranslatedWorld).xyz;
	Sample.WorldNormal = float3(0, 0, 0);
	Sample.bHasNormal = false;
	return Sample;
}

// Depth, world position and normal of a pixel (clamped to the view rect).
// Adds the normal of the pixel (clamped to the view rect) to its depth sample.
void LoadSampleNormal(int2 ClampedPos, inout FThinOutlineSample Sample)
{
#if SUBSTRATE_GBUFFER_FORMAT == 1
	const FSubstrateTopLayerData TopLayerData = SubstrateUnpackTopLayerData(Substrate.TopLayerTexture.Load(uint3(ClampedPos, 0)));
	Sample.WorldNormal = TopLayerData.WorldNormal;
	Sample.bHasNormal = IsSubstrateMaterial(TopLayerData);
#else
	const FGBufferData GBuffer = GetGBufferDataUint(uint2(ClampedPos));
	Sample.WorldNormal = GBuffer.WorldNormal;
	Sample.bHasNormal = GBuffer.ShadingModelID != SHADINGMODELID_UNLIT;
#endif

	Sample.bHasNormal = Sample.bHasNormal && !Sample.bIsSky && dot(Sample.WorldNormal, Sample.WorldNormal) > 0.25;
}

FThinOutlineSample LoadOutlineSample(int2 PixelPos)
{
	const int2 ClampedPos = ClampToViewRect(PixelPos);
	FThinOutlineSample Sample = LoadDepthSample(ClampedPos);
	LoadSampleNormal(ClampedPos, Sample);
	return Sample;
}

// Loads the target pixel and its axial neighbours (clamped to the view rect) in NeighbourOffsets order, and the depth
// samples of the pixels two steps away (the pixel beyond each neighbour; the spike filter adds a normal where it needs
// one, see DetectEdges).
void LoadOutlineNeighbourhood(
	int2 PixelPos,
	out FThinOutlineSample Center,
	out FThinOutlineSample Neighbours[4],
	out FThinOutlineSample FarNeighbours[4])
{
	Center = LoadOutlineSample(PixelPos);

	UNROLL
	for (uint NeighbourIndex = 0; NeighbourIndex < 4; ++NeighbourIndex)
	{
		Neighbours[NeighbourIndex] = LoadOutlineSample(PixelPos + NeighbourOffsets[NeighbourIndex]);
		FarNeighbours[NeighbourIndex] = LoadDepthSample(PixelPos + 2 * NeighbourOffsets[NeighbourIndex]);
	}
}

// Distance of Position from the line through the samples A and B, or -1 when there is no line: A is sky, or A is B
// itself (clamped at the view rect border).
float GetDistanceFromLine(float3 Position, FThinOutlineSample A, FThinOutlineSample B)
{
	const float3 LineDirection = B.TranslatedWorldPosition - A.TranslatedWorldPosition;
	const float LineLengthSquared = dot(LineDirection, LineDirection);
	if (A.bIsSky || LineLengthSquared <= 0.0)
	{
		return -1.0;
	}
	return length(cross(Position - B.TranslatedWorldPosition, LineDirection)) * rsqrt(LineLengthSquared);
}

// Depth discontinuity between the target C and its neighbour N, with O the pixel on the other side of C and F the pixel
// beyond N, relative to C's depth (see the top of the file). Not defined for a sky C.
float GetDepthEdgeMeasure(FThinOutlineSample C, FThinOutlineSample N, FThinOutlineSample O, FThinOutlineSample F)
{
	if (N.bIsSky)
	{
		return THIN_OUTLINE_FAR_DEPTH;
	}

	// A sky O makes C the foreground of a silhouette toward O, which says nothing about N.
	float Distance = GetDistanceFromLine(N.TranslatedWorldPosition, O, C);
	if (Distance < 0.0)
	{
		return 0.0;
	}

	if (bSymmetricDepthMeasure != 0)
	{
		const float DistanceFromNSide = GetDistanceFromLine(C.TranslatedWorldPosition, F, N);
		if (DistanceFromNSide >= 0.0)
		{
			Distance = min(Distance, DistanceFromNSide);
		}
	}
	return Distance / C.Depth;
}

// Normal discontinuity between the target C and the neighbour N, extrapolating the normal rotation from O through C.
float GetCreaseEdgeMeasure(float3 NormalC, float3 NormalN, float3 NormalO)
{
	const float3 CrossOC = cross(NormalO, NormalC);
	const float3 CrossCN = cross(NormalC, NormalN);
	return min(length(CrossCN - CrossOC), length(CrossCN));
}

float GetEdgeStrength(float Measure, float Threshold, float Scale)
{
	return Measure > Threshold ? saturate((Measure - Threshold) * Scale) : 0.0;
}

// Whether two pixels are one surface for the spike filter: their normals agree within its threshold (the sine of the
// angle between them) and B's sample lies on A's plane within its plane tolerance (relative to A's depth). Without the
// plane test a thin step top between two risers facing the same way (a wall top in front of the next wall) counted as
// a spike on the frames when the jitter put it in one pixel row, and lost its crease.
bool IsSameSurfaceForSpike(FThinOutlineSample A, FThinOutlineSample B)
{
	return A.bHasNormal && B.bHasNormal
		&& length(cross(A.WorldNormal, B.WorldNormal)) < CreaseSpikeThreshold
		&& abs(dot(B.TranslatedWorldPosition - A.TranslatedWorldPosition, A.WorldNormal)) <= CreaseSpikePlaneTolerance * A.Depth;
}

// Silhouette strength of the background pixel's check of C toward N (O on the other side of C, F beyond N): C must be
// farther than N. A sky pixel next to geometry is always a silhouette.
float GetSilhouetteStrength(FThinOutlineSample C, FThinOutlineSample N, FThinOutlineSample O, FThinOutlineSample F)
{
	if (C.bIsSky)
	{
		return N.bIsSky ? 0.0 : 1.0;
	}
	if (C.Depth > N.Depth)
	{
		return GetEdgeStrength(GetDepthEdgeMeasure(C, N, O, F), SilhouetteThreshold, SilhouetteScale);
	}
	return 0.0;
}

struct FThinOutlineEdges
{
	// Silhouette strength of the foreground pixel's check toward each axial direction (NeighbourOffsets order): the
	// neighbour is the background. These checks record samples.
	float Silhouette[4];
	// Silhouette strength of the background pixel's check toward each axial direction: the neighbour is the foreground.
	float BackgroundSilhouette[4];
	// Largest of both.
	float MaxSilhouette;
	// Crease strength of each axial direction. All zero when the pixel has a silhouette.
	float Crease[4];
	// Crease measure of each axial direction, also when the pixel has a silhouette; 0 across a depth discontinuity or
	// without normals. The crease history test compares it with its own, lower thresholds.
	float CreaseMeasure[4];
	// Whether the crease of each direction is a ridge (convex) rather than a valley.
	bool bRidge[4];
	// Directions (bit i for NeighbourOffsets[i]) whose crease check was skipped as a one-pixel normal spike
	// (CREASE_SPIKE_FILTER; debug view 9).
	uint SpikeMask;
};

// Crease measure of the check of C toward N, O being the pixel on the other side of C (its normal only counts when it is
// on C's surface: otherwise there is no normal rotation to extrapolate), and whether the crease is a ridge (convex: the
// normals diverge along the direction from C to N).
float GetCreaseCheckMeasure(FThinOutlineSample C, FThinOutlineSample N, FThinOutlineSample O, bool bOppositeOnSurface, out bool bRidge)
{
	const float3 OppositeNormal = bOppositeOnSurface ? O.WorldNormal : C.WorldNormal;
	bRidge = dot(N.WorldNormal - C.WorldNormal, N.TranslatedWorldPosition - C.TranslatedWorldPosition) > 0.0;
	return GetCreaseEdgeMeasure(C.WorldNormal, N.WorldNormal, OppositeNormal);
}

// See LoadOutlineNeighbourhood for the arguments; PixelPos is the target's (the spike filter loads from it).
FThinOutlineEdges DetectEdges(int2 PixelPos, FThinOutlineSample Center, FThinOutlineSample Neighbours[4], FThinOutlineSample FarNeighbours[4])
{
	FThinOutlineEdges Edges;
	Edges.MaxSilhouette = 0.0;
	Edges.SpikeMask = 0;

	// The depth edge measure toward each neighbour, computed once: the silhouette check toward it, the crease check's
	// same-surface test toward it, and the opposite direction's test of its opposite pixel all use the same one.
	float DepthEdgeMeasures[4];
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		DepthEdgeMeasures[Index] = GetDepthEdgeMeasure(Center, Neighbours[Index], Neighbours[Index ^ 1], FarNeighbours[Index]);
	}

	// The background side as GetSilhouetteStrength; the foreground side with the same measure, toward a farther
	// neighbour (a sky neighbour's measure is huge).
	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		const FThinOutlineSample Neighbour = Neighbours[Index];
		if (Center.bIsSky)
		{
			Edges.Silhouette[Index] = 0.0;
			Edges.BackgroundSilhouette[Index] = Neighbour.bIsSky ? 0.0 : 1.0;
		}
		else
		{
			const float Strength = GetEdgeStrength(DepthEdgeMeasures[Index], SilhouetteThreshold, SilhouetteScale);
			Edges.Silhouette[Index] = Center.Depth < Neighbour.Depth ? Strength : 0.0;
			Edges.BackgroundSilhouette[Index] = Center.Depth > Neighbour.Depth ? Strength : 0.0;
		}
		Edges.MaxSilhouette = max(Edges.MaxSilhouette, max(Edges.Silhouette[Index], Edges.BackgroundSilhouette[Index]));
	}

	UNROLL
	for (uint Index = 0; Index < 4; ++Index)
	{
		Edges.Crease[Index] = 0.0;
		Edges.CreaseMeasure[Index] = 0.0;
		Edges.bRidge[Index] = false;

		const FThinOutlineSample Neighbour = Neighbours[Index];
		const FThinOutlineSample Opposite = Neighbours[Index ^ 1];

		// Creases only exist between pixels of a depth-continuous surface.
		if (Center.bHasNormal && Neighbour.bHasNormal && DepthEdgeMeasures[Index] <= SilhouetteThreshold)
		{
			const bool bOppositeOnSurface = Opposite.bHasNormal && DepthEdgeMeasures[Index ^ 1] <= SilhouetteThreshold;
			bool bRidge;
			Edges.CreaseMeasure[Index] = GetCreaseCheckMeasure(Center, Neighbour, Opposite, bOppositeOnSurface, bRidge);
			Edges.bRidge[Index] = bRidge;

			// Silhouettes take priority: a pixel with a silhouette on either side is not a crease candidate.
			if (Edges.MaxSilhouette <= 0.0)
			{
				Edges.Crease[Index] = GetEdgeStrength(Edges.CreaseMeasure[Index], bRidge ? CreaseRidgeThreshold : CreaseValleyThreshold, CreaseScale);
			}
		}
	}

#if CREASE_SPIKE_FILTER
	// r.ThinOutline.Crease.SpikeFilter: a one-pixel spike of the normal field is not a crease (a groove wall thinner than
	// a pixel, hit by the jittered sample on some frames: a few pixels pop on every frame of a distant surface, and the
	// records they fed drew dots that blinked or stayed). The target is a spike when it has a crease toward both of its
	// neighbours along an axis and those two are one surface (IsSameSurfaceForSpike: normals agreeing, one plane); a
	// neighbour is a spike when the target has a crease toward it and the target and the pixel beyond the neighbour are
	// one surface. Both checks of a spike target and the check toward a spike neighbour are skipped, and their measure
	// cleared, so the crease is not found there either. The normal of the pixel beyond a neighbour is loaded only where
	// the target has a crease toward that neighbour and is not a spike itself: a few percent of the pixels (loading all
	// four up front for every pixel cost 0.007 ms at 73%, about 7% of the plugin's time). A real ridge one pixel wide on
	// a flat surface (a thin wall seen edge-on at a distance) is dropped with the spikes; a step is kept.
	BRANCH
	if (bCreaseSpikeFilter != 0)
	{
		UNROLL
		for (uint Axis = 0; Axis < 2; ++Axis)
		{
			const uint First = 2 * Axis;
			const uint Second = First + 1;
			const bool bCreaseFirst = Edges.CreaseMeasure[First] > (Edges.bRidge[First] ? CreaseRidgeThreshold : CreaseValleyThreshold);
			const bool bCreaseSecond = Edges.CreaseMeasure[Second] > (Edges.bRidge[Second] ? CreaseRidgeThreshold : CreaseValleyThreshold);
			const bool bCenterSpike = bCreaseFirst && bCreaseSecond && IsSameSurfaceForSpike(Neighbours[First], Neighbours[Second]);

			UNROLL
			for (uint Index = First; Index <= Second; ++Index)
			{
				const bool bCrease = Index == First ? bCreaseFirst : bCreaseSecond;
				bool bNeighbourSpike = false;
				BRANCH
				if (bCrease && !bCenterSpike)
				{
					FThinOutlineSample Far = FarNeighbours[Index];
					LoadSampleNormal(ClampToViewRect(PixelPos + 2 * NeighbourOffsets[Index]), Far);
					bNeighbourSpike = IsSameSurfaceForSpike(Center, Far);
				}
				if (bCenterSpike || bNeighbourSpike)
				{
					Edges.Crease[Index] = 0.0;
					Edges.CreaseMeasure[Index] = 0.0;
					Edges.SpikeMask |= 1u << Index;
				}
			}
		}
	}
#endif

	return Edges;
}

//------------------------------------------------------- EDGE RECORDS

// Edge type of a record, stored in the sign of its sample count (negative for silhouettes). An empty record has no type.
#define EDGE_CREASE 0
#define EDGE_SILHOUETTE 1

// The foreground depth of silhouette records is stored in fp16 in meters (linear depth is in cm): up to 65 km, with
// 0.05% relative precision.
#define THIN_OUTLINE_FOREGROUND_DEPTH_STORE_SCALE 0.01

// Running statistics of the samples of one inducer axis, as (u, v) = (along the axis, across it).
// Moments are central, so moving a record to other pixel-local coordinates only moves its mean.
struct FThinOutlineRecord
{
	// Decayed sample count n.
	float SampleCount;
	float2 Mean;
	float2 Variance;
	float Covariance;
	// Bad frames in a row (ThinOutlineRecord.usf, UpdateAxisRecord): frames on which the record failed a history test or,
	// for a crease record, met a silhouette sample. The record is kept, at full strength, until
	// r.ThinOutline.Estimator.FadeFrames.
	float FadeCount;
	// Mean edge strength of the samples.
	float Strength;
	// Fraction of the samples recorded through the left (top) check. Only stored for silhouettes, where it is close
	// to 1 when the background is on the left (top) and close to 0 when it is on the right (bottom).
	float KeptRatio;
	// Silhouettes: mean linear depth of the pixel when it recorded its samples, i.e. of the foreground. Creases (with the
	// crease history test of ThinOutlineRecord.usf): frames since a crease was last found at the pixel along the axis.
	float ForegroundDepth;
};

FThinOutlineRecord GetEmptyRecord()
{
	return (FThinOutlineRecord)0;
}

// Two RGBA16F textures per axis: A = (n, mean u, mean v, fade count), B = (variance u, variance v, covariance,
// strength), with -n for silhouette records. The kept ratio and foreground depth of silhouette records are stored
// separately.
FThinOutlineRecord UnpackRecord(float4 A, float4 B, out uint EdgeType)
{
	FThinOutlineRecord Record;
	Record.SampleCount = abs(A.x);
	Record.Mean = A.yz;
	Record.FadeCount = A.w;
	Record.Variance = B.xy;
	Record.Covariance = B.z;
	Record.Strength = B.w;
	Record.KeptRatio = 0.0;
	Record.ForegroundDepth = 0.0;
	EdgeType = A.x < 0.0 ? EDGE_SILHOUETTE : EDGE_CREASE;
	return Record;
}

void PackRecord(FThinOutlineRecord Record, uint EdgeType, out float4 A, out float4 B)
{
	A = float4(EdgeType == EDGE_SILHOUETTE ? -Record.SampleCount : Record.SampleCount, Record.Mean, Record.FadeCount);
	B = float4(Record.Variance, Record.Covariance, Record.Strength);
}

// Exponentially weighted update of the running mean and central moments with one new sample of weight 1.
// Kept is 1 for a sample of the left (top) check, 0 for one of the right (bottom) check. ForegroundDepth is the linear
// depth of the foreground (only used by silhouette records).
void AddRecordSample(inout FThinOutlineRecord Record, float2 Sample, float Kept, float Strength, float ForegroundDepth)
{
	Record.SampleCount += 1.0;
	const float Alpha = rcp(Record.SampleCount);
	const float2 Delta = Sample - Record.Mean;

	Record.Mean += Alpha * Delta;
	Record.Variance = (1.0 - Alpha) * (Record.Variance + Alpha * Delta * Delta);
	Record.Covariance = (1.0 - Alpha) * (Record.Covariance + Alpha * Delta.x * Delta.y);
	Record.Strength += Alpha * (Strength - Record.Strength);
	Record.KeptRatio += Alpha * (Kept - Record.KeptRatio);
	Record.ForegroundDepth += Alpha * (ForegroundDepth - Record.ForegroundDepth);
}

// Re-expresses a record in the local coordinates of a pixel whose origin is at Offset = (along, across) in the
// record's coordinates. u stores trapezoid midlines, whose far side is pinned to the pixel boundary, so it moves
// at half rate.
void ShiftRecord(inout FThinOutlineRecord Record, float2 Offset)
{
	Record.Mean -= float2(0.5 * Offset.x, Offset.y);
}

// Statistics of the union of the samples of two records (expressed in the same coordinates).
FThinOutlineRecord MergeRecords(FThinOutlineRecord Record0, FThinOutlineRecord Record1)
{
	FThinOutlineRecord Merged;
	Merged.SampleCount = Record0.SampleCount + Record1.SampleCount;

	const float Weight0 = Merged.SampleCount > 0.0 ? Record0.SampleCount / Merged.SampleCount : 0.0;
	const float Weight1 = 1.0 - Weight0;

	Merged.Mean = Weight0 * Record0.Mean + Weight1 * Record1.Mean;

	const float2 Delta0 = Record0.Mean - Merged.Mean;
	const float2 Delta1 = Record1.Mean - Merged.Mean;
	Merged.Variance = Weight0 * (Record0.Variance + Delta0 * Delta0) + Weight1 * (Record1.Variance + Delta1 * Delta1);
	Merged.Covariance = Weight0 * (Record0.Covariance + Delta0.x * Delta0.y) + Weight1 * (Record1.Covariance + Delta1.x * Delta1.y);
	Merged.FadeCount = Weight0 * Record0.FadeCount + Weight1 * Record1.FadeCount;
	Merged.Strength = Weight0 * Record0.Strength + Weight1 * Record1.Strength;
	Merged.KeptRatio = Weight0 * Record0.KeptRatio + Weight1 * Record1.KeptRatio;
	Merged.ForegroundDepth = Weight0 * Record0.ForegroundDepth + Weight1 * Record1.ForegroundDepth;
	return Merged;
}

// Edge u = Intercept + Slope * v in pixel-local coordinates (u, v) of its axis, reconstructed from a record by OLS.
struct FThinOutlineEdgeFit
{
	bool bValid;
	float Intercept;
	float Slope;
	// Standard error of the slope b of the OLS line u = a + b v through the record (not of the doubled edge line).
	float SlopeStandardError;
	// Standard error of the edge line's position at the pixel's center (v = 0.5), in pixels: that of the record line's
	// value there, doubled like the line. The least uncertain point of the line, and uncorrelated with its slope.
	float CrossingStandardError;
};

// DistinctSampleScale converts the decayed sample count into the number of distinct jitter positions behind it, which is
// what the sample count of the standard errors has to be: repeated positions add no information, and a record of only
// two distinct positions fits a line exactly, with a zero standard error.
FThinOutlineEdgeFit FitEdge(FThinOutlineRecord Record, float DistinctSampleScale)
{
	FThinOutlineEdgeFit Fit = (FThinOutlineEdgeFit)0;

	const float SampleCount = Record.SampleCount * DistinctSampleScale;
	Fit.bValid = SampleCount >= THIN_OUTLINE_MIN_FIT_SAMPLE_COUNT && Record.Variance.y > THIN_OUTLINE_MIN_FIT_VARIANCE;
	if (!Fit.bValid)
	{
		return Fit;
	}

	const float B = Record.Covariance / Record.Variance.y;
	const float A = Record.Mean.x - B * Record.Mean.y;

	const float ResidualVariance = max(Record.Variance.x - Record.Covariance * B, 0.0) * SampleCount / (SampleCount - 2.0);
	Fit.SlopeStandardError = sqrt(ResidualVariance / (SampleCount * Record.Variance.y));
	const float CenterOffset = 0.5 - Record.Mean.y;
	Fit.CrossingStandardError = 2.0 * sqrt(ResidualVariance / SampleCount * (1.0 + CenterOffset * CenterOffset / Record.Variance.y));

	// The record fits the trapezoid midline u = 0.5 + E / 2.
	Fit.Intercept = 2.0 * A - 1.0;
	Fit.Slope = 2.0 * B;
	return Fit;
}

//------------------------------------------------------- COVERAGE

// Integral over Length of max(g, 0), with g linear from G0 to G1.
float IntegrateRamp(float G0, float G1, float Length)
{
	const float GMin = min(G0, G1);
	const float GMax = max(G0, G1);

	if (GMin >= 0.0)
	{
		return Length * 0.5 * (G0 + G1);
	}
	if (GMax <= 0.0)
	{
		return 0.0;
	}
	return Length * 0.5 * GMax * GMax / (GMax - GMin);
}

// Area of {(u, v) in [RectMin, RectMax] : u - Slope * v <= Offset}.
float GetHalfPlaneArea(float Offset, float Slope, float2 RectMin, float2 RectMax)
{
	const float Width = RectMax.x - RectMin.x;
	const float Height = RectMax.y - RectMin.y;

	// Extent along u of the half plane inside the rect, measured from RectMin.x, at both ends of the v range.
	const float G0 = Offset + Slope * RectMin.y - RectMin.x;
	const float G1 = Offset + Slope * RectMax.y - RectMin.x;
	return IntegrateRamp(G0, G1, Height) - IntegrateRamp(G0 - Width, G1 - Width, Height);
}

// Area inside [RectMin, RectMax] of the band of points whose signed distance from the line u = Intercept + Slope * v,
// positive toward +u, lies in [BandMin, BandMax].
float GetBandArea(float Intercept, float Slope, float BandMin, float BandMax, float2 RectMin, float2 RectMax)
{
	const float DistanceToU = sqrt(1.0 + Slope * Slope);
	return GetHalfPlaneArea(Intercept + BandMax * DistanceToU, Slope, RectMin, RectMax)
		- GetHalfPlaneArea(Intercept + BandMin * DistanceToU, Slope, RectMin, RectMax);
}
