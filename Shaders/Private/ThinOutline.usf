/*=============================================================================
	ThinOutline.usf: draws the outline reconstructed from the edge records at rendering resolution.

	Each axis of a pixel keeps one record, a crease or a silhouette record. Per axis, a pixel fits the pooled samples of
	its own record and its two neighbours' along the axis, weighted by their sample counts, taking only the records of
	the edge type it evaluates. The neighbours' records are shifted into the pixel's coordinates by -0.5
	(left/top neighbour) and +0.5 (right/bottom neighbour). Around an edge all three describe the same line, so
	neighbouring pixels pool nearly the same samples, and a pixel whose own history was just reset still gets its
	neighbours' data. Records with a co-trigger ratio above the threshold mix in a second edge and are left out; a
	pixel whose own record is above it has no edge on that axis.

	Of the two axes' edges, only those whose outline band crosses this pixel are candidates. Of two candidates, the one
	with the clearly smaller slope standard error wins, otherwise the one with the smaller absolute slope.
	A crease band is centered on the edge. A silhouette band lies on the background side of the edge only, so the
	outline wraps around the foreground; the kept ratio of the records gives the side. A pixel without silhouette
	samples of its own is foreground and draws no silhouette. Silhouette candidates take priority over creases. An axis
	whose own record is a silhouette record draws no crease.

	The outline alpha is the edge strength times the fraction of the display pixel (temporal upscaler output) under
	this frame's sample, clipped to this rendering pixel, that the outline band covers.

	A pixel painted with a silhouette shows the foreground's contour, so the depth and velocity of the foreground pixel
	of the silhouette on the foreground side are written out for ThinOutlineForeground.usf, which copies them into the
	scene depth and velocity: the temporal upscaler then moves the outline with the foreground.
=============================================================================*/

#include "ThinOutlineCommon.ush"
#include "/Engine/Private/ScreenPass.ush"

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

Texture2D InputSceneColorTexture;

Texture2D<float4> HorizontalA;
Texture2D<float4> HorizontalB;
Texture2D<float4> VerticalA;
Texture2D<float4> VerticalB;
Texture2D<float2> SilhouetteKept;

// Device Z (0 where nothing is overwritten) and encoded velocity to give each pixel, indexed by viewport position.
RWTexture2D<float> RWForegroundDeviceZ;
RWTexture2D<float4> RWForegroundVelocity;

float3 CreaseColor;
float3 SilhouetteColor;
// This frame's G-buffer sample position inside its rendering pixel, in pixel-local coordinates [0, 1]^2.
float2 SampleLocalPosition;
float2 RenderPixelsPerDisplayPixel;
// Outline thicknesses, in rendering pixels.
float CreaseThickness;
float SilhouetteThickness;
float CoTriggerThreshold;
float SlopeStandardErrorThreshold;
// The jitter sequence repeats every L frames, so a record that gets a sample on a fraction f of the frames holds about
// f * L distinct jitter positions, while its sample count is f / d: distinct = count * min(1, d * L).
float DistinctSampleScale;
// Sample count of a record that receives a sample every frame (1 / decay rate).
float SaturatedSampleCount;
uint DebugView;

#define AXIS_HORIZONTAL 0
#define AXIS_VERTICAL 1

// A pixel's record of one axis. Outside the view: empty.
FThinOutlineRecord LoadRecord(uint Axis, int2 ViewportPos, out uint EdgeType)
{
	EdgeType = EDGE_CREASE;
	if (any(ViewportPos < 0) || any(ViewportPos >= int2(View.ViewSizeAndInvSize.xy)))
	{
		return GetEmptyRecord();
	}

	const int3 Texel = int3(ViewportPos, 0);
	FThinOutlineRecord Record;
	if (Axis == AXIS_HORIZONTAL)
	{
		Record = UnpackRecord(HorizontalA.Load(Texel), HorizontalB.Load(Texel), EdgeType);
		Record.KeptRatio = SilhouetteKept.Load(Texel).x;
	}
	else
	{
		Record = UnpackRecord(VerticalA.Load(Texel), VerticalB.Load(Texel), EdgeType);
		Record.KeptRatio = SilhouetteKept.Load(Texel).y;
	}
	return Record;
}

int2 GetAxisStep(uint Axis)
{
	return Axis == AXIS_HORIZONTAL ? int2(1, 0) : int2(0, 1);
}

// The records of a pixel and of its two neighbours along an axis: left (top), own, right (bottom).
struct FThinOutlineAxisRecords
{
	FThinOutlineRecord Records[3];
	uint EdgeTypes[3];
};

FThinOutlineAxisRecords LoadAxisRecords(uint Axis, int2 ViewportPos)
{
	const int2 AxisStep = GetAxisStep(Axis);

	FThinOutlineAxisRecords AxisRecords;
	UNROLL
	for (int Index = 0; Index < 3; ++Index)
	{
		AxisRecords.Records[Index] = LoadRecord(Axis, ViewportPos + (Index - 1) * AxisStep, AxisRecords.EdgeTypes[Index]);
	}
	return AxisRecords;
}

// The record at Index if it is of the given type, else an empty record.
FThinOutlineRecord GetRecordOfType(FThinOutlineAxisRecords AxisRecords, int Index, uint EdgeType)
{
	FThinOutlineRecord Record = GetEmptyRecord();
	if (AxisRecords.EdgeTypes[Index] == EdgeType)
	{
		Record = AxisRecords.Records[Index];
	}
	return Record;
}

// AlongOffset: this pixel's origin along the axis, in the record's coordinates.
void PoolRecord(inout FThinOutlineRecord Pooled, FThinOutlineRecord Record, float AlongOffset)
{
	if (Record.SampleCount > 0.0 && Record.CoTriggerRatio <= CoTriggerThreshold)
	{
		ShiftRecord(Record, float2(AlongOffset, 0.0));
		Pooled = MergeRecords(Pooled, Record);
	}
}

// The own record and the neighbours' of the given type, pooled.
FThinOutlineRecord GetFitRecord(uint EdgeType, FThinOutlineAxisRecords AxisRecords)
{
	FThinOutlineRecord Pooled = GetEmptyRecord();
	PoolRecord(Pooled, GetRecordOfType(AxisRecords, 0, EdgeType), 1.0);
	PoolRecord(Pooled, GetRecordOfType(AxisRecords, 1, EdgeType), 0.0);
	PoolRecord(Pooled, GetRecordOfType(AxisRecords, 2, EdgeType), -1.0);
	return Pooled;
}

struct FThinOutlineCandidate
{
	bool bValid;
	FThinOutlineEdgeFit Fit;
	float Strength;
	// The outline band, as signed distances from the edge line, positive toward +u.
	float BandMin;
	float BandMax;
	// Silhouettes: the background, and so the band, is on the +u side of the edge.
	bool bBackgroundAlongU;
};

FThinOutlineCandidate GetCandidate(uint EdgeType, FThinOutlineAxisRecords AxisRecords)
{
	const FThinOutlineRecord OwnRecord = GetRecordOfType(AxisRecords, 1, EdgeType);
	const bool bOwnRecordOfOtherType = AxisRecords.EdgeTypes[1] != EdgeType && AxisRecords.Records[1].SampleCount > 0.0;
	const FThinOutlineRecord Record = GetFitRecord(EdgeType, AxisRecords);

	FThinOutlineCandidate Candidate;
	Candidate.Fit = FitEdge(Record, DistinctSampleScale);
	Candidate.Strength = Record.Strength;
	Candidate.bBackgroundAlongU = false;

	if (EdgeType == EDGE_CREASE)
	{
		Candidate.BandMin = -0.5 * CreaseThickness;
		Candidate.BandMax = 0.5 * CreaseThickness;
	}
	else
	{
		// Samples of the left (top) check come from background pixels whose foreground is on the left (top).
		Candidate.bBackgroundAlongU = Record.KeptRatio >= 0.5;
		Candidate.BandMin = Candidate.bBackgroundAlongU ? 0.0 : -SilhouetteThickness;
		Candidate.BandMax = Candidate.bBackgroundAlongU ? SilhouetteThickness : 0.0;
	}

	// A pixel whose own record mixes in a second edge has no edge on this axis: between two close edges, the pooled
	// neighbours would put a line in the gap. A pixel that never sampled a silhouette itself is its foreground: its
	// pooled neighbours describe the contour, but painting it would eat into the foreground's shape. An axis whose own
	// record is a silhouette record draws no crease.
	// The pixel only draws the part of the outline band that crosses it.
	Candidate.bValid = Candidate.Fit.bValid
		&& OwnRecord.CoTriggerRatio <= CoTriggerThreshold
		&& (EdgeType == EDGE_CREASE ? !bOwnRecordOfOtherType : OwnRecord.SampleCount > 0.0)
		&& GetBandArea(Candidate.Fit.Intercept, Candidate.Fit.Slope, Candidate.BandMin, Candidate.BandMax, float2(0.0, 0.0), float2(1.0, 1.0)) > THIN_OUTLINE_MIN_BAND_AREA;
	return Candidate;
}

// Of the two axes' candidates (at least one valid), whether the vertical one is drawn.
bool SelectVertical(FThinOutlineCandidate Horizontal, FThinOutlineCandidate Vertical)
{
	if (Horizontal.bValid != Vertical.bValid)
	{
		return Vertical.bValid;
	}
	if (abs(Horizontal.Fit.SlopeStandardError - Vertical.Fit.SlopeStandardError) > SlopeStandardErrorThreshold)
	{
		return Vertical.Fit.SlopeStandardError < Horizontal.Fit.SlopeStandardError;
	}
	// Each slope is measured against its own inducer axis, so the smaller one crosses its axis more squarely.
	return abs(Vertical.Fit.Slope) < abs(Horizontal.Fit.Slope);
}

// Drawn with FScreenPassVS (AddDrawScreenPass): the inputs must match its outputs in order, even when unused,
// otherwise the VS/PS signatures do not link and D3D12 fails to create the pipeline state.
void MainPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoPSInput StereoInput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const uint2 OutputViewportPos = uint2(SvPosition.xy) - Output_ViewportMin;
	const float4 SceneColor = InputSceneColorTexture.Load(int3(Input_ViewportMin + OutputViewportPos, 0));
	const int2 ViewportPos = int2(OutputViewportPos);
	const int2 PixelPos = int2(View.ViewRectMin.xy) + ViewportPos;

	const FThinOutlineAxisRecords HorizontalRecords = LoadAxisRecords(AXIS_HORIZONTAL, ViewportPos);
	const FThinOutlineAxisRecords VerticalRecords = LoadAxisRecords(AXIS_VERTICAL, ViewportPos);

	FThinOutlineCandidate Horizontal = GetCandidate(EDGE_SILHOUETTE, HorizontalRecords);
	FThinOutlineCandidate Vertical = GetCandidate(EDGE_SILHOUETTE, VerticalRecords);
	bool bSilhouette = true;

	BRANCH
	if (!Horizontal.bValid && !Vertical.bValid)
	{
		Horizontal = GetCandidate(EDGE_CREASE, HorizontalRecords);
		Vertical = GetCandidate(EDGE_CREASE, VerticalRecords);
		bSilhouette = false;
	}

	float Alpha = 0.0;
	bool bVertical = false;
	float ForegroundDeviceZ = 0.0;
	float4 ForegroundVelocity = 0.0;

	if (Horizontal.bValid || Vertical.bValid)
	{
		bVertical = SelectVertical(Horizontal, Vertical);

		FThinOutlineCandidate Selected = Horizontal;
		if (bVertical)
		{
			Selected = Vertical;
		}

		// The display pixel under this frame's sample, clipped to this rendering pixel, in pixel-local coordinates.
		// Every sample landing in it reports the same coverage.
		const float2 SamplePosition = float2(ViewportPos) + min(SampleLocalPosition, 0.9999);
		const float2 DisplayPixel = floor(SamplePosition / RenderPixelsPerDisplayPixel);
		const float2 RectMin = max(DisplayPixel * RenderPixelsPerDisplayPixel - float2(ViewportPos), 0.0);
		const float2 RectMax = min((DisplayPixel + 1.0) * RenderPixelsPerDisplayPixel - float2(ViewportPos), 1.0);
		const float RectArea = (RectMax.x - RectMin.x) * (RectMax.y - RectMin.y);

		// Coverage is computed in the (u, v) coordinates of the selected edge's axis.
		const float BandArea = bVertical
			? GetBandArea(Selected.Fit.Intercept, Selected.Fit.Slope, Selected.BandMin, Selected.BandMax, RectMin.yx, RectMax.yx)
			: GetBandArea(Selected.Fit.Intercept, Selected.Fit.Slope, Selected.BandMin, Selected.BandMax, RectMin, RectMax);

		const float Coverage = RectArea > 0.0 ? saturate(BandArea / RectArea) : 0.0;
		Alpha = Coverage * saturate(Selected.Strength);

		if (bSilhouette && Alpha > 0.0)
		{
			// The foreground is the near side of the first silhouette, by the edge checks' own test, walking from the
			// pixel up to two pixels toward the foreground: one pixel outside the contour, the axial neighbour may sample
			// the background this frame. A pixel that samples the foreground itself finds none and keeps its own values.
			const int2 AxisStep = GetAxisStep(bVertical ? AXIS_VERTICAL : AXIS_HORIZONTAL);
			const int2 ForegroundStep = Selected.bBackgroundAlongU ? -AxisStep : AxisStep;

			FThinOutlineSample Previous = LoadDepthSample(PixelPos - ForegroundStep);
			FThinOutlineSample Current = LoadDepthSample(PixelPos);
			FThinOutlineSample Next = LoadDepthSample(PixelPos + ForegroundStep);
			bool bFound = false;
			UNROLL
			for (int Distance = 1; Distance <= 2; ++Distance)
			{
				const FThinOutlineSample Beyond = LoadDepthSample(PixelPos + (Distance + 1) * ForegroundStep);
				if (!bFound && GetSilhouetteStrength(Current, Next, Previous, Beyond) > 0.0)
				{
					bFound = true;
					ForegroundDeviceZ = Next.DeviceZ;
					ForegroundVelocity = SceneTexturesStruct.GBufferVelocityTexture.Load(int3(ClampToViewRect(PixelPos + Distance * ForegroundStep), 0));
				}
				Previous = Current;
				Current = Next;
				Next = Beyond;
			}
		}
	}

	RWForegroundDeviceZ[ViewportPos] = ForegroundDeviceZ;
	RWForegroundVelocity[ViewportPos] = ForegroundVelocity;

	BRANCH
	if (DebugView == 1)
	{
		FThinOutlineSample Center;
		FThinOutlineSample Neighbours[4];
		FThinOutlineSample FarNeighbours[4];
		LoadOutlineNeighbourhood(PixelPos, Center, Neighbours, FarNeighbours);
		const FThinOutlineEdges Edges = DetectEdges(Center, Neighbours, FarNeighbours);

		float Ridge = 0.0;
		float Valley = 0.0;
		UNROLL
		for (uint Index = 0; Index < 4; ++Index)
		{
			Ridge = max(Ridge, Edges.bRidge[Index] ? Edges.Crease[Index] : 0.0);
			Valley = max(Valley, Edges.bRidge[Index] ? 0.0 : Edges.Crease[Index]);
		}

		OutColor = float4(Edges.MaxSilhouette, Ridge, Valley, SceneColor.a);
	}
	else if (DebugView == 2 || DebugView == 4)
	{
		const uint EdgeType = DebugView == 2 ? EDGE_CREASE : EDGE_SILHOUETTE;
		const FThinOutlineRecord HorizontalRecord = GetRecordOfType(HorizontalRecords, 1, EdgeType);
		const FThinOutlineRecord VerticalRecord = GetRecordOfType(VerticalRecords, 1, EdgeType);

		// Creases: co-trigger ratio. Silhouettes: kept ratio of the record with more samples.
		const float Blue = EdgeType == EDGE_CREASE
			? max(HorizontalRecord.CoTriggerRatio, VerticalRecord.CoTriggerRatio)
			: (HorizontalRecord.SampleCount >= VerticalRecord.SampleCount ? HorizontalRecord.KeptRatio : VerticalRecord.KeptRatio);

		OutColor = float4(
			saturate(HorizontalRecord.SampleCount / SaturatedSampleCount),
			saturate(VerticalRecord.SampleCount / SaturatedSampleCount),
			Blue,
			SceneColor.a);
	}
	else if (DebugView == 3)
	{
		OutColor = float4(bVertical ? 0.0 : Alpha, bVertical ? Alpha : 0.0, bSilhouette ? Alpha : 0.0, SceneColor.a);
	}
	else if (DebugView == 5)
	{
		OutColor = float4(ForegroundDeviceZ > 0.0 ? 1.0 : 0.0, bSilhouette ? Alpha : 0.0, 0.0, SceneColor.a);
	}
	else
	{
		OutColor = float4(lerp(SceneColor.rgb, bSilhouette ? SilhouetteColor : CreaseColor, Alpha), SceneColor.a);
	}
}
