/*=============================================================================
	ThinOutline.usf: draws the outline reconstructed from the edge records, at rendering resolution before the temporal
	upscaler (MainPS), or with r.ThinOutline.DrawAfterUpscaler at display resolution after it (AfterUpscalerPS).

	Since 2026-10-10 the edge a rendering pixel draws is reconstructed once per rendering pixel by the edge pass
	(ThinOutlineEdge.usf, with the selection code of ThinOutlineSelect.ush: the pooled fits, the choice of axis, the
	spatial filter, the dense edge suppression), which leaves one line per pixel in the DrawnEdge texture. The
	composites only compute the coverage of that line's band.

	MainPS: the outline alpha is the edge strength times the fraction of the display pixel (temporal upscaler output)
	under this frame's sample, clipped to this rendering pixel, that the outline band covers.
	A pixel painted with a silhouette shows the foreground's contour, so the depth and velocity of the foreground pixel
	of the silhouette on the foreground side are written out for ThinOutlineForeground.usf, which copies them into the
	scene depth and velocity: the temporal upscaler then moves the outline with the foreground.

	AfterUpscalerPS: a display pixel adds up, over the rendering pixels it overlaps, the edge strength times the
	fraction of the display pixel that each one's outline band covers inside the overlap. No jitter is involved, so the
	coverage is exact, and depth and velocity stay untouched.
	AfterUpscalerCS (r.ThinOutline.TileClassification): the same, for the display tiles that have records within reach
	only (one thread group per tile listed by ThinOutlineTileClassify.usf), reading and writing the scene color in place.
=============================================================================*/

// The debug views 1 and 9 show the edge checks with the spike filter, which needs the normals two pixels away.
#define CREASE_SPIKE_FILTER 1

#include "ThinOutlineSelect.ush"
#include "/Engine/Private/ScreenPass.ush"

SCREEN_PASS_TEXTURE_VIEWPORT(Input)
SCREEN_PASS_TEXTURE_VIEWPORT(Output)

Texture2D InputSceneColorTexture;

// Device Z (0 where nothing is overwritten) and encoded velocity to give each pixel, indexed by viewport position.
RWTexture2D<float> RWForegroundDeviceZ;
RWTexture2D<float4> RWForegroundVelocity;

// This frame's G-buffer sample position inside its rendering pixel, in pixel-local coordinates [0, 1]^2.
float2 SampleLocalPosition;
// The edge each rendering pixel draws, from the edge pass (ThinOutlineEdge.usf, PackDrawnEdge).
Texture2D<float4> DrawnEdge;

// AfterUpscalerCS: the tile list of ThinOutlineTileClassify.usf, and the scene color it reads and writes in place.
StructuredBuffer<uint> TileList;
RWTexture2D<float4> RWSceneColor;

// MainPS's work for one rendering pixel: the scene color with its outline (or a debug view), and the foreground depth
// and velocity the pixel hands to ThinOutlineForeground.usf (0 where it keeps its own).
float4 GetMainColor(int2 ViewportPos, float4 SceneColor, out float ForegroundDeviceZ, out float4 ForegroundVelocity)
{
	const int2 PixelPos = int2(View.ViewRectMin.xy) + ViewportPos;
	const FThinOutlineDrawnEdge Edge = UnpackDrawnEdge(DrawnEdge.Load(int3(ViewportPos, 0)));

	float Alpha = 0.0;
	// The alpha a dense edge, or an isolated one, would have drawn (debug view 7).
	float SuppressedAlpha = 0.0;
	float IsolatedAlpha = 0.0;
	ForegroundDeviceZ = 0.0;
	ForegroundVelocity = 0.0;

	if (Edge.bValid)
	{
		// The display pixel under this frame's sample, clipped to this rendering pixel, in pixel-local coordinates.
		// Every sample landing in it reports the same coverage.
		const float2 SamplePosition = float2(ViewportPos) + min(SampleLocalPosition, 0.9999);
		const float2 DisplayPixel = floor(SamplePosition / RenderPixelsPerDisplayPixel);
		const float2 RectMin = max(DisplayPixel * RenderPixelsPerDisplayPixel - float2(ViewportPos), 0.0);
		const float2 RectMax = min((DisplayPixel + 1.0) * RenderPixelsPerDisplayPixel - float2(ViewportPos), 1.0);
		const float RectArea = (RectMax.x - RectMin.x) * (RectMax.y - RectMin.y);

		const float BandArea = GetCandidateBandArea(Edge.Candidate, Edge.bVertical, RectMin, RectMax);
		const float Coverage = RectArea > 0.0 ? saturate(BandArea / RectArea) : 0.0;
		Alpha = saturate(Coverage * max(Edge.Candidate.Strength, 0.0));
		if (Edge.bSuppressed)
		{
			SuppressedAlpha = Edge.bIsolated ? 0.0 : Alpha;
			IsolatedAlpha = Edge.bIsolated ? Alpha : 0.0;
			Alpha = 0.0;
		}

		if (Edge.bSilhouette && Alpha > 0.0)
		{
			int2 ForegroundPixelPos;
			float FoundDeviceZ;
			if (FindSilhouetteForeground(PixelPos, Edge.bVertical, Edge.Candidate.bBackgroundAlongU, ForegroundPixelPos, FoundDeviceZ))
			{
				ForegroundDeviceZ = FoundDeviceZ;
				ForegroundVelocity = SceneTexturesStruct.GBufferVelocityTexture.Load(int3(ForegroundPixelPos, 0));
			}
		}
	}

	BRANCH
	if (DebugView == 1 || DebugView == 2 || DebugView == 4 || DebugView == 9)
	{
		return float4(GetPixelDebugColor(PixelPos, LoadAxisRecords(AXIS_HORIZONTAL, ViewportPos), LoadAxisRecords(AXIS_VERTICAL, ViewportPos)), SceneColor.a);
	}
	if (DebugView == 3)
	{
		return float4(Edge.bVertical ? 0.0 : Alpha, Edge.bVertical ? Alpha : 0.0, Edge.bSilhouette ? Alpha : 0.0, SceneColor.a);
	}
	if (DebugView == 5)
	{
		return float4(ForegroundDeviceZ > 0.0 ? 1.0 : 0.0, Edge.bSilhouette ? Alpha : 0.0, 0.0, SceneColor.a);
	}
	if (DebugView == 7)
	{
		return float4(SuppressedAlpha, Alpha, IsolatedAlpha, SceneColor.a);
	}
	return float4(lerp(SceneColor.rgb, Edge.bSilhouette ? SilhouetteColor : CreaseColor, Alpha), SceneColor.a);
}

// Drawn with FScreenPassVS (AddDrawScreenPass): the inputs must match its outputs in order, even when unused,
// otherwise the VS/PS signatures do not link and D3D12 fails to create the pipeline state.
void MainPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoPSInput StereoInput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const uint2 OutputViewportPos = uint2(SvPosition.xy) - Output_ViewportMin;
	const float4 SceneColor = InputSceneColorTexture.Load(int3(Input_ViewportMin + OutputViewportPos, 0));
	const int2 ViewportPos = int2(OutputViewportPos);

	float ForegroundDeviceZ;
	float4 ForegroundVelocity;
	OutColor = GetMainColor(ViewportPos, SceneColor, ForegroundDeviceZ, ForegroundVelocity);
	RWForegroundDeviceZ[ViewportPos] = ForegroundDeviceZ;
	RWForegroundVelocity[ViewportPos] = ForegroundVelocity;
}

// r.ThinOutline.TileClassification: MainPS's work for the rendering tiles that have records within reach only, one
// thread group per tile listed by ThinOutlineTileClassify.usf, reading and writing the scene color in place. The
// foreground depth and velocity are written for the listed tiles' pixels only, the only ones the overwrite pass reads.
// Debug view 6 tints the tiles by the record types found; the other tiles keep their color (for debug views 3 and 5 the
// scene color is cleared to black first).
[numthreads(THIN_OUTLINE_TILE_SIZE, THIN_OUTLINE_TILE_SIZE, 1)]
void CompositeCS(uint GroupId : SV_GroupID, uint2 GroupThreadId : SV_GroupThreadID)
{
	const uint Entry = TileList[GroupId];
	const uint2 OutputViewportPos = UnpackTileEntryCoord(Entry) * THIN_OUTLINE_TILE_SIZE + GroupThreadId;
	if (any(OutputViewportPos >= uint2(Output_ViewportSize)))
	{
		return;
	}

	const int2 ViewportPos = int2(OutputViewportPos);
	const int2 Texel = int2(Output_ViewportMin + OutputViewportPos);
	const float4 SceneColor = RWSceneColor[Texel];

	BRANCH
	if (DebugView == 6)
	{
		RWForegroundDeviceZ[ViewportPos] = 0.0;
		RWForegroundVelocity[ViewportPos] = 0.0;
		RWSceneColor[Texel] = float4(lerp(SceneColor.rgb, GetTileDebugColor(Entry), 0.5), SceneColor.a);
		return;
	}

	float ForegroundDeviceZ;
	float4 ForegroundVelocity;
	const float4 Color = GetMainColor(ViewportPos, SceneColor, ForegroundDeviceZ, ForegroundVelocity);
	RWForegroundDeviceZ[ViewportPos] = ForegroundDeviceZ;
	RWForegroundVelocity[ViewportPos] = ForegroundVelocity;
	RWSceneColor[Texel] = Color;
}

// The outline alpha of a display pixel drawn after the upscaler, by the edges of each inducer axis and by the
// silhouettes among them. The edge lines of the records are in the un-jittered coordinates of the rendering pixels, so
// a display pixel reads them directly: each rendering pixel it overlaps draws the part of its drawn edge's band (the
// edge pass's DrawnEdge) inside the overlap, as MainPS draws the part inside the display pixel under its sample. The
// rendering pixels draw separate parts of the display pixel, so their alphas add up. SuppressedAlpha, IsolatedAlpha:
// the alpha the edges that r.ThinOutline.DenseEdgeSuppression and IsolatedEdgeSuppression removed would have drawn
// (debug view 7).
void GetDisplayPixelAlpha(uint2 OutputViewportPos, out float HorizontalAlpha, out float VerticalAlpha, out float SilhouetteAlpha, out float SuppressedAlpha, out float IsolatedAlpha)
{
	const int2 ViewSize = int2(View.ViewSizeAndInvSize.xy);

	// The display pixel in rendering pixels from the view's origin (neighbouring display pixels share their borders exactly),
	// and the rendering pixels it overlaps.
	const float2 DisplayRectMin = float2(OutputViewportPos) * RenderPixelsPerDisplayPixel;
	const float2 DisplayRectMax = (float2(OutputViewportPos) + 1.0) * RenderPixelsPerDisplayPixel;
	const float DisplayRectArea = RenderPixelsPerDisplayPixel.x * RenderPixelsPerDisplayPixel.y;
	const int2 FirstPixel = max(int2(floor(DisplayRectMin + THIN_OUTLINE_MIN_OVERLAP)), 0);
	const int2 LastPixel = min(int2(ceil(DisplayRectMax - THIN_OUTLINE_MIN_OVERLAP)) - 1, ViewSize - 1);

	HorizontalAlpha = 0.0;
	VerticalAlpha = 0.0;
	SilhouetteAlpha = 0.0;
	SuppressedAlpha = 0.0;
	IsolatedAlpha = 0.0;

	LOOP
	for (int Y = FirstPixel.y; Y <= LastPixel.y; ++Y)
	{
		LOOP
		for (int X = FirstPixel.x; X <= LastPixel.x; ++X)
		{
			const int2 ViewportPos = int2(X, Y);
			const FThinOutlineDrawnEdge Edge = UnpackDrawnEdge(DrawnEdge.Load(int3(ViewportPos, 0)));
			if (Edge.bValid)
			{
				// The overlap, in pixel-local coordinates of the rendering pixel.
				const float2 RectMin = max(DisplayRectMin - float2(ViewportPos), 0.0);
				const float2 RectMax = min(DisplayRectMax - float2(ViewportPos), 1.0);
				const float BandArea = max(GetCandidateBandArea(Edge.Candidate, Edge.bVertical, RectMin, RectMax), 0.0);
				const float Alpha = BandArea / DisplayRectArea * max(Edge.Candidate.Strength, 0.0);

				if (Edge.bSuppressed)
				{
					SuppressedAlpha += Edge.bIsolated ? 0.0 : Alpha;
					IsolatedAlpha += Edge.bIsolated ? Alpha : 0.0;
				}
				else
				{
					HorizontalAlpha += Edge.bVertical ? 0.0 : Alpha;
					VerticalAlpha += Edge.bVertical ? Alpha : 0.0;
					SilhouetteAlpha += Edge.bSilhouette ? Alpha : 0.0;
				}
			}
		}
	}
}

// The scene color of a display pixel with its outline, or debug view 3, 5 or 7 (any other debug view draws the outline).
float4 GetAfterUpscalerColor(float4 SceneColor, float HorizontalAlpha, float VerticalAlpha, float SilhouetteAlpha, float SuppressedAlpha, float IsolatedAlpha)
{
	if (DebugView == 3)
	{
		return float4(HorizontalAlpha, VerticalAlpha, SilhouetteAlpha, SceneColor.a);
	}
	if (DebugView == 5)
	{
		// Nothing is overwritten in this mode.
		return float4(0.0, SilhouetteAlpha, 0.0, SceneColor.a);
	}
	if (DebugView == 7)
	{
		return float4(SuppressedAlpha, HorizontalAlpha + VerticalAlpha, IsolatedAlpha, SceneColor.a);
	}
	const float Alpha = saturate(HorizontalAlpha + VerticalAlpha);
	const float CreaseAlpha = max(HorizontalAlpha + VerticalAlpha - SilhouetteAlpha, 0.0);
	return float4(SceneColor.rgb * (1.0 - Alpha) + SilhouetteAlpha * SilhouetteColor + CreaseAlpha * CreaseColor, SceneColor.a);
}

// r.ThinOutline.DrawAfterUpscaler: drawn at display resolution (the temporal upscaler's output), see
// GetDisplayPixelAlpha. Drawn with FScreenPassVS, see MainPS.
void AfterUpscalerPS(
	noperspective float4 UVAndScreenPos : TEXCOORD0,
	FStereoPSInput StereoInput,
	float4 SvPosition : SV_POSITION,
	out float4 OutColor : SV_Target0)
{
	const uint2 OutputViewportPos = uint2(SvPosition.xy) - Output_ViewportMin;
	const float4 SceneColor = InputSceneColorTexture.Load(int3(Input_ViewportMin + OutputViewportPos, 0));

	BRANCH
	if (DebugView == 1 || DebugView == 2 || DebugView == 4 || DebugView == 9)
	{
		// The rendering pixel under the display pixel's center.
		const int2 ViewSize = int2(View.ViewSizeAndInvSize.xy);
		const int2 ViewportPos = clamp(int2((float2(OutputViewportPos) + 0.5) * RenderPixelsPerDisplayPixel), 0, ViewSize - 1);
		const FThinOutlineAxisRecords HorizontalRecords = LoadAxisRecords(AXIS_HORIZONTAL, ViewportPos);
		const FThinOutlineAxisRecords VerticalRecords = LoadAxisRecords(AXIS_VERTICAL, ViewportPos);
		OutColor = float4(GetPixelDebugColor(int2(View.ViewRectMin.xy) + ViewportPos, HorizontalRecords, VerticalRecords), SceneColor.a);
		return;
	}

	float HorizontalAlpha;
	float VerticalAlpha;
	float SilhouetteAlpha;
	float SuppressedAlpha;
	float IsolatedAlpha;
	GetDisplayPixelAlpha(OutputViewportPos, HorizontalAlpha, VerticalAlpha, SilhouetteAlpha, SuppressedAlpha, IsolatedAlpha);
	OutColor = GetAfterUpscalerColor(SceneColor, HorizontalAlpha, VerticalAlpha, SilhouetteAlpha, SuppressedAlpha, IsolatedAlpha);
}

// r.ThinOutline.TileClassification: AfterUpscalerPS's work for the display tiles that have records within reach only,
// one thread group per tile listed by ThinOutlineTileClassify.usf, reading and writing the scene color in place. The
// other tiles keep their color (for debug views 3, 5 and 7 the scene color is cleared to black first). Debug view 6 tints
// the tiles by the record types found: crease records only green, silhouette records only red, both yellow.
[numthreads(THIN_OUTLINE_TILE_SIZE, THIN_OUTLINE_TILE_SIZE, 1)]
void AfterUpscalerCS(uint GroupId : SV_GroupID, uint2 GroupThreadId : SV_GroupThreadID)
{
	const uint Entry = TileList[GroupId];
	const uint2 OutputViewportPos = UnpackTileEntryCoord(Entry) * THIN_OUTLINE_TILE_SIZE + GroupThreadId;
	if (any(OutputViewportPos >= uint2(Output_ViewportSize)))
	{
		return;
	}

	const int2 Texel = int2(Output_ViewportMin + OutputViewportPos);
	const float4 SceneColor = RWSceneColor[Texel];

	BRANCH
	if (DebugView == 6)
	{
		RWSceneColor[Texel] = float4(lerp(SceneColor.rgb, GetTileDebugColor(Entry), 0.5), SceneColor.a);
		return;
	}

	float HorizontalAlpha;
	float VerticalAlpha;
	float SilhouetteAlpha;
	float SuppressedAlpha;
	float IsolatedAlpha;
	GetDisplayPixelAlpha(OutputViewportPos, HorizontalAlpha, VerticalAlpha, SilhouetteAlpha, SuppressedAlpha, IsolatedAlpha);
	RWSceneColor[Texel] = GetAfterUpscalerColor(SceneColor, HorizontalAlpha, VerticalAlpha, SilhouetteAlpha, SuppressedAlpha, IsolatedAlpha);
}
